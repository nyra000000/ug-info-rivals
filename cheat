local rainbowHues = {
    Fill=0, Outline=0, Box=0, Name=0, Skeleton=0, Tracers=0, FOVCircle=0, BulletTracer=0,
}
local fovCircle = nil

local function stepRainbow(dt)
    if next(Cache) == nil and not CONFIG.FOVCircleEnabled and #BulletTracers == 0 then return end

    local doFill = CONFIG.FillRainbow
    local doOutline = CONFIG.OutlineRainbow
    local doBox = CONFIG.BoxRainbow
    local doName = CONFIG.NameRainbow
    local doSkel = CONFIG.SkeletonRainbow
    local doTrac = CONFIG.TracersRainbow
    local doFov = CONFIG.FOVCircleRainbow
    local doBullet = CONFIG.BulletTracerRainbow

    if doFill then rainbowHues.Fill = (rainbowHues.Fill + dt * CONFIG.FillRainbowSpeed) % 1 end
    if doOutline then rainbowHues.Outline = (rainbowHues.Outline + dt * CONFIG.OutlineRainbowSpeed) % 1 end
    if doBox then rainbowHues.Box = (rainbowHues.Box + dt * CONFIG.BoxRainbowSpeed) % 1 end
    if doName then rainbowHues.Name = (rainbowHues.Name + dt * CONFIG.NameRainbowSpeed) % 1 end
    if doSkel then rainbowHues.Skeleton = (rainbowHues.Skeleton + dt * CONFIG.SkeletonRainbowSpeed) % 1 end
    if doTrac then rainbowHues.Tracers = (rainbowHues.Tracers + dt * CONFIG.TracersRainbowSpeed) % 1 end
    if doFov then rainbowHues.FOVCircle = (rainbowHues.FOVCircle + dt * CONFIG.FOVCircleRainbowSpeed) % 1 end
    if doBullet then rainbowHues.BulletTracer = (rainbowHues.BulletTracer + dt * CONFIG.BulletTracerRainbowSpeed) % 1 end

    local cFill = Color3.fromHSV(rainbowHues.Fill, 1, 1)
    local cOutline = Color3.fromHSV(rainbowHues.Outline, 1, 1)
    local cBox = Color3.fromHSV(rainbowHues.Box, 1, 1)
    local cName = Color3.fromHSV(rainbowHues.Name, 1, 1)
    local cSkel = Color3.fromHSV(rainbowHues.Skeleton, 1, 1)
    local cTrac = Color3.fromHSV(rainbowHues.Tracers, 1, 1)
    local cFov = Color3.fromHSV(rainbowHues.FOVCircle, 1, 1)
    local cBullet = Color3.fromHSV(rainbowHues.BulletTracer, 1, 1)

    for _, e in pairs(Cache) do
        if e.highlight then
            if doFill then e.highlight.FillColor = cFill end
            if doOutline then e.highlight.OutlineColor = cOutline end
        end
        if doBox and e.box then e.box.Color = cBox end
        if doName and e.name then e.name.Color = cName end
        if doSkel and e.bones then
            for _, b in ipairs(e.bones) do b.Color = cSkel end
        end
        if doTrac and e.tracer then e.tracer.Color = cTrac end
    end

    if #BulletTracers > 0 then
        for _, t in ipairs(BulletTracers) do
            if t.line and t.line.Visible then
                if doBullet then t.line.Color = cBullet
                else t.line.Color = CONFIG.BulletTracerColor end
            end
        end
    end

    if doFov and fovCircle then fovCircle.Color = cFov end
end

