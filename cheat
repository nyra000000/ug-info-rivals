                _m.Name = wn
                if _eq[wn] then for ct, cd in pairs(_eq[wn]) do _m[ct] = cd end end
                return _m
            end
        end)
        safeNotify("Unlock All", "All cosmetics unlocked!", 5)
        UnlockAll.initialized = true
        UnlockAll.running = false
    end)
