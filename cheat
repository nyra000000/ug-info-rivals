local function getAimPart(character)
    if CONFIG.AimTargetMode == 1 then return character:FindFirstChild("Head")
    elseif CONFIG.AimTargetMode == 2 then return character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
    else return character:FindFirstChild("HumanoidRootPart") end
end

local function getClosestEnemy()
    local closest, shortest = nil, CONFIG.AimFOV
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChild("Humanoid")
            local tp = getAimPart(char)
            if hum and tp and hum.Health > 0 then
                if CONFIG.AimVisibleCheck and not isVisible(tp) then continue end
                local sp = Camera:WorldToViewportPoint(tp.Position)
                if sp.Z > 0 then
                    local mp = UserInputService:GetMouseLocation()
                    local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mp.X, mp.Y)).Magnitude
                    if d < shortest then shortest = d; closest = tp end
                end
            end
        end
    end
    return closest
end

local function aimAt(target)
    if not target then return end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local sp, onScreen = Camera:WorldToViewportPoint(target.Position)
    if not onScreen then return end
    local dx = (sp.X - center.X) * CONFIG.AimLockSpeed
    local dy = (sp.Y - center.Y) * CONFIG.AimLockSpeed
    if mousemoverel then mousemoverel(dx, dy)
    elseif syn and syn.mousemoverel then syn.mousemoverel(dx, dy)
    else local VIM = game:GetService("VirtualInputManager"); if VIM then VIM:SendMouseMoveEvent(dx, dy, false) end end
end

local function isAimKeyDown() return KeyState[CONFIG.AimKey] == true end

