        local n = tool.Name:lower()
        if n:find("katana") or n:find("lame") or n:find("sabre") then return true end
    end
    local viewmodels = workspace:FindFirstChild("ViewModels")
    if viewmodels then
        local prefix = plr.Name .. " - "
        for _, vm in ipairs(viewmodels:GetChildren()) do
            if vm.Name:sub(1, #prefix) == prefix then
                local suffix = vm.Name:sub(#prefix + 1):lower()
                if suffix:find("katana") or suffix:find("lame") or suffix:find("sabre") then return true end
            end
        end
        local fp = viewmodels:FindFirstChild("FirstPerson")
        if fp then
            for _, vm in ipairs(fp:GetChildren()) do
                if vm.Name:sub(1, #prefix) == prefix then
                    local suffix = vm.Name:sub(#prefix + 1):lower()
                    if suffix:find("katana") or suffix:find("lame") or suffix:find("sabre") then return true end
                end
            end
        end
    end
    local fighterCtrl = getgenv()._antiKatanaFighterController
    if not fighterCtrl then
        pcall(function()
            local ok, fc = pcall(require, LocalPlayer.PlayerScripts.Controllers.FighterController)
            if ok and fc then fighterCtrl = fc; getgenv()._antiKatanaFighterController = fc end
        end)
    end
    if fighterCtrl then
