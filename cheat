        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 10); bc.Parent = btn
        local bs = Instance.new("UIStroke")
        bs.Color = accentColor or Color3.fromRGB(190,190,190)
        bs.Thickness = 1
        bs.Transparency = accentColor and 0.3 or 0.45
        bs.Parent = btn

        local base = color or COLORS.bgSecondary

        btn.MouseEnter:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.16), {BackgroundColor3 = COLORS.bgHover}):Play()
        end)
        btn.MouseLeave:Connect(function()
            TweenService:Create(btn, TweenInfo.new(0.16), {BackgroundColor3 = base}):Play()
        end)
        btn.MouseButton1Click:Connect(function()
