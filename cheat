local LowGfxState = {
    Applied = false,
    SavedQuality = nil, SavedPostFX = nil, SavedShadows = nil,
    SavedAmbient = nil, SavedOutdoor = nil, SavedBrightness = nil,
    SavedFogEnd = nil, SavedFogStart = nil,
}

applyLowestGraphics = function()
    pcall(function()
        local settings = UserSettings():GetService("UserGameSettings")
        if LowGfxState.SavedQuality == nil then LowGfxState.SavedQuality = settings.SavedQualityLevel end
        settings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
    end)
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    if Lighting then
        if LowGfxState.SavedShadows == nil then LowGfxState.SavedShadows = Lighting.GlobalShadows end
        pcall(function() Lighting.GlobalShadows = false end)
    end
    if Lighting then
        if not LowGfxState.SavedPostFX then LowGfxState.SavedPostFX = {} end
        pcall(function()
            for _, fx in ipairs(Lighting:GetChildren()) do
                if fx:IsA("PostEffect") then
                    if LowGfxState.SavedPostFX[fx] == nil then LowGfxState.SavedPostFX[fx] = fx.Enabled end
                    fx.Enabled = false
                end
            end
        end)
    end
    if Lighting then
        pcall(function()
            if LowGfxState.SavedAmbient == nil then LowGfxState.SavedAmbient = Lighting.Ambient end
            if LowGfxState.SavedOutdoor == nil then LowGfxState.SavedOutdoor = Lighting.OutdoorAmbient end
            if LowGfxState.SavedBrightness == nil then LowGfxState.SavedBrightness = Lighting.Brightness end
            Lighting.Ambient = Color3.fromRGB(0, 0, 0)
            Lighting.OutdoorAmbient = Color3.fromRGB(0, 0, 0)
            Lighting.Brightness = 0
        end)
    end
    if Lighting then
        pcall(function()
            if LowGfxState.SavedFogEnd == nil then LowGfxState.SavedFogEnd = Lighting.FogEnd end
            if LowGfxState.SavedFogStart == nil then LowGfxState.SavedFogStart = Lighting.FogStart end
            Lighting.FogEnd = 100000
            Lighting.FogStart = 0
        end)
    end
    if Workspace.StreamingEnabled ~= nil then
        pcall(function() Workspace.StreamingEnabled = false end)
    end
    if Workspace.Terrain then
        pcall(function()
            Workspace.Terrain.WaterWaveSize = 0
            Workspace.Terrain.WaterWaveSpeed = 0
            Workspace.Terrain.WaterReflectance = 0
            Workspace.Terrain.WaterTransparency = 1
        end)
    end
    LowGfxState.Applied = true
    CONFIG.MiscLowestGraphics = true
    return true, "Graphismes minimaux appliqués"
end

restoreLowestGraphics = function()
    pcall(function()
        if LowGfxState.SavedQuality then
            local settings = UserSettings():GetService("UserGameSettings")
            settings.SavedQualityLevel = LowGfxState.SavedQuality
        end
    end)
    if Lighting then
        pcall(function()
            if LowGfxState.SavedShadows ~= nil then Lighting.GlobalShadows = LowGfxState.SavedShadows end
            if LowGfxState.SavedAmbient then Lighting.Ambient = LowGfxState.SavedAmbient end
            if LowGfxState.SavedOutdoor then Lighting.OutdoorAmbient = LowGfxState.SavedOutdoor end
            if LowGfxState.SavedBrightness then Lighting.Brightness = LowGfxState.SavedBrightness end
            if LowGfxState.SavedFogEnd then Lighting.FogEnd = LowGfxState.SavedFogEnd end
            if LowGfxState.SavedFogStart then Lighting.FogStart = LowGfxState.SavedFogStart end
        end)
        if LowGfxState.SavedPostFX then
            pcall(function()
                for fx, wasEnabled in pairs(LowGfxState.SavedPostFX) do
                    if fx and fx.Parent then fx.Enabled = wasEnabled end
                end
            end)
        end
    end
    LowGfxState.Applied = false
    CONFIG.MiscLowestGraphics = false
end

