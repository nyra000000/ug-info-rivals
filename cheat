        btn.Size = UDim2.new(1, 0, 1, 18); btn.Position = UDim2.new(0, 0, 0, -9)
        btn.BackgroundTransparency = 1; btn.Text = ""; btn.Parent = bg
        local function upd(mx)
            local ap = bg.AbsolutePosition.X; local as = bg.AbsoluteSize.X
            local rel = math.clamp((mx - ap) / as, 0, 1)
            onChange(rel)
        end
        btn.MouseButton1Down:Connect(function()
            dragging = true; upd(UserInputService:GetMouseLocation().X)
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then upd(input.Position.X) end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end)
    end

