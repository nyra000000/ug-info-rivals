-- ============================================================
local function makeCache(p)
    if not HasDrawing or ESPCache[p] then return end
    local c = {}
    c.box = {}; c.boxO = {}
    for i = 1, 4 do
        c.boxO[i] = newDraw("Line", {Color = Color3.new(0, 0, 0), Thickness = 3})
        c.box[i]  = newDraw("Line", {Thickness = 1.5})
    end
    c.cor = {}
    for i = 1, 8 do c.cor[i] = newDraw("Line", {Thickness = 1.5}) end
    c.sk = {}
    for i = 1, 14 do c.sk[i] = newDraw("Line", {Thickness = 1.5}) end
    c.trO = newDraw("Line", {Color = Color3.new(0, 0, 0), Thickness = 3})
    c.tr  = newDraw("Line", {Thickness = 1.5})
    c.nm  = newDraw("Text", {Size = 13, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0)})
    c.dt  = newDraw("Text", {Size = 11, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0)})
    c.wp  = newDraw("Text", {Size = 10, Center = true, Outline = true, OutlineColor = Color3.new(0, 0, 0)})
    c.hBg = newDraw("Square", {Color = Color3.new(0, 0, 0), Filled = true, Transparency = 0.5})
    c.hBo = newDraw("Square", {Color = Color3.fromRGB(40, 40, 40), Filled = false, Thickness = 1})
    c.hFi = newDraw("Square", {Color = Color3.fromRGB(60, 220, 120), Filled = true})
    c.headDot  = newDraw("Circle", {Thickness = 1, Filled = true, NumSides = 16, Radius = 3})
    c.chinaHat = newDraw("Circle", {Thickness = 2, Filled = false, NumSides = 32, Radius = 15})
    c.lookDir  = newDraw("Line", {Thickness = 2})
    c.boxFill  = newDraw("Square", {Filled = true, Transparency = 0.2})

    c._a = {}
    for _, tbl in pairs({c.box, c.boxO, c.cor, c.sk}) do
        for _, v in pairs(tbl) do if v then table.insert(c._a, v) end end
    end
    for _, v in pairs({c.boxFill, c.trO, c.tr, c.nm, c.dt, c.wp, c.hBg, c.hBo, c.hFi, c.headDot, c.chinaHat, c.lookDir}) do
        if v then table.insert(c._a, v) end
    end
    ESPCache[p] = c
end

local function removeCache(p)
    local c = ESPCache[p]
    if not c then return end
    for _, o in ipairs(c._a) do pcall(function() o:Remove() end) end
    ESPCache[p] = nil
end

local function hideAll(p)
    local c = ESPCache[p]
    if not c then return end
    for _, o in ipairs(c._a) do pcall(function() o.Visible = false end) end
end

local function updateDrawESP(player)
    local c = ESPCache[player]
    if not c or not Toggles.ESPOn.Value then
        if c then hideAll(player) end
        return
    end
    local useTeamCheck = Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value
    if useTeamCheck and not isEnemy(player, true) then hideAll(player); return end
    local useDeadCheck = Toggles.ESPDeadCheck and Toggles.ESPDeadCheck.Value
    if not isAlive(player, useDeadCheck) then hideAll(player); return end

    local ch = player.Character
    if not ch then hideAll(player); return end
    local hum  = ch:FindFirstChildOfClass("Humanoid")
    local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
    local head = ch:FindFirstChild("Head")
    if not root or not head or not hum then hideAll(player); return end

    local camP = Camera.CFrame.Position
    local d = dist3(camP, root.Position)
    if d > Options.ESPMaxD.Value then hideAll(player); return end

    local rS, rOn = w2s(root.Position)
    if not rOn then hideAll(player); return end
    local tS, tOn = w2s(head.Position + Vector3.new(0, head.Size.Y / 2 + 0.3, 0))
    local bS, bOn = w2s(root.Position - Vector3.new(0, 3, 0))
    if not tOn or not bOn then hideAll(player); return end

    local bH = math.abs(bS.Y - tS.Y)
    if bH < 2 then hideAll(player); return end
    local bW = bH * 0.6
    local cx = (tS.X + bS.X) / 2
    local tl = Vector2.new(cx - bW / 2, tS.Y)
    local tr = Vector2.new(cx + bW / 2, tS.Y)
    local bl = Vector2.new(cx - bW / 2, bS.Y)
    local br = Vector2.new(cx + bW / 2, bS.Y)
    local boxCol = Options.ESPBoxCol.Value

    if Toggles.ESPBoxOn.Value and not Toggles.ESPCorner.Value then
        local segs = {{tl, tr}, {tr, br}, {br, bl}, {bl, tl}}
        for i = 1, 4 do
            if Toggles.ESPBoxOut.Value and c.boxO[i] then
                c.boxO[i].From = segs[i][1]; c.boxO[i].To = segs[i][2]; c.boxO[i].Visible = true
            elseif c.boxO[i] then c.boxO[i].Visible = false end
            if c.box[i] then
                c.box[i].From = segs[i][1]; c.box[i].To = segs[i][2]
                c.box[i].Color = boxCol; c.box[i].Visible = true
            end
        end
        if Toggles.ESPBoxFill.Value and c.boxFill then
            c.boxFill.Position = tl
            c.boxFill.Size = Vector2.new(bW, bH)
            c.boxFill.Color = Options.ESPBoxFillCol.Value
            c.boxFill.Visible = true
        elseif c.boxFill then c.boxFill.Visible = false end
    else
        for i = 1, 4 do
            if c.box[i] then c.box[i].Visible = false end
            if c.boxO[i] then c.boxO[i].Visible = false end
        end
        if c.boxFill then c.boxFill.Visible = false end
    end

    if Toggles.ESPBoxOn.Value and Toggles.ESPCorner.Value then
        local cLen = bH * 0.22
        local cn = {
            {tl, tl + Vector2.new(cLen, 0)},
            {tl, tl + Vector2.new(0, cLen)},
            {tr, tr + Vector2.new(-cLen, 0)},
            {tr, tr + Vector2.new(0, cLen)},
            {bl, bl + Vector2.new(cLen, 0)},
            {bl, bl + Vector2.new(0, -cLen)},
            {br, br + Vector2.new(-cLen, 0)},
            {br, br + Vector2.new(0, -cLen)}
        }
        for i = 1, 8 do
            if c.cor[i] then
                c.cor[i].From = cn[i][1]; c.cor[i].To = cn[i][2]
                c.cor[i].Color = boxCol; c.cor[i].Visible = true
            end
        end
    else
        for i = 1, 8 do if c.cor[i] then c.cor[i].Visible = false end end
    end

    if Toggles.ESPSkel.Value then
        local bones = getBones(ch)
        for i = 1, 14 do
            local l = c.sk[i]
            if l then
                if bones[i] then
                    local a = ch:FindFirstChild(bones[i][1])
                    local b = ch:FindFirstChild(bones[i][2])
                    if a and b then
                        local sa, oa = w2s(a.Position)
                        local sb, ob = w2s(b.Position)
                        if oa and ob then
                            l.From = sa; l.To = sb
                            l.Color = Options.ESPSkelCol.Value
                            l.Visible = true
                        else l.Visible = false end
                    else l.Visible = false end
                else l.Visible = false end
            end
        end
    else
        for i = 1, 14 do if c.sk[i] then c.sk[i].Visible = false end end
    end

    if Toggles.ESPHeadDot.Value and c.headDot then
        local hS, hOn = w2s(head.Position)
        if hOn then
            c.headDot.Position = hS
            c.headDot.Color = Options.ESPHeadDotCol.Value
            c.headDot.Radius = Options.ESPHeadDotSize.Value
            c.headDot.Visible = true
        else c.headDot.Visible = false end
    elseif c.headDot then c.headDot.Visible = false end

    if Toggles.ESPChinaHat.Value and c.chinaHat then
        local hS, hOn = w2s(head.Position + Vector3.new(0, head.Size.Y + Options.ESPChinaHatHeight.Value, 0))
        if hOn then
            c.chinaHat.Position = hS
            c.chinaHat.Color = Options.ESPChinaHatCol.Value
            c.chinaHat.Radius = Options.ESPChinaHatSize.Value
            c.chinaHat.Visible = true
        else c.chinaHat.Visible = false end
    elseif c.chinaHat then c.chinaHat.Visible = false end

    if Toggles.ESPLookDir.Value and c.lookDir then
        local lookPos = head.Position + (head.CFrame.LookVector * Options.ESPLookDirLength.Value)
        local start2D, startOn = w2s(head.Position)
        local end2D, endOn = w2s(lookPos)
        if startOn and endOn then
            c.lookDir.From = start2D
            c.lookDir.To = end2D
            c.lookDir.Color = Options.ESPLookDirCol.Value
            c.lookDir.Thickness = Options.ESPLookDirThick.Value
            c.lookDir.Visible = true
        else c.lookDir.Visible = false end
    elseif c.lookDir then c.lookDir.Visible = false end

    if Toggles.ESPName.Value and c.nm then
        c.nm.Text = player.DisplayName
        c.nm.Position = Vector2.new(cx, tS.Y - 16)
        c.nm.Color = Options.ESPNameCol.Value
        local fp = Options.ESPNameFont.Value and FontPresets[Options.ESPNameFont.Value]
        c.nm.Font = fp and fp.Font or 0
        c.nm.Size = fp and fp.Size or 13
        c.nm.Visible = true
    elseif c.nm then c.nm.Visible = false end

    if Toggles.ESPDist.Value and c.dt then
        c.dt.Text = string.format("[%dm]", math.floor(d))
        c.dt.Position = Vector2.new(cx, bS.Y + 2)
        c.dt.Color = Options.ESPDistCol.Value
        local fp = Options.ESPDistFont.Value and FontPresets[Options.ESPDistFont.Value]
        c.dt.Font = fp and fp.Font or 0
        c.dt.Size = fp and fp.Size or 11
        c.dt.Visible = true
    elseif c.dt then c.dt.Visible = false end

    if Toggles.ESPWep.Value and c.wp then
        local wn = getWeapon(ch)
        if wn then
            c.wp.Text = "[" .. wn .. "]"
            c.wp.Position = Vector2.new(cx, bS.Y + (Toggles.ESPDist.Value and 14 or 2))
            c.wp.Color = Options.ESPWepCol.Value
            local fp = Options.ESPWepFont.Value and FontPresets[Options.ESPWepFont.Value]
            c.wp.Font = fp and fp.Font or 0
            c.wp.Size = fp and fp.Size or 10
            c.wp.Visible = true
        else c.wp.Visible = false end
    elseif c.wp then c.wp.Visible = false end

    if Toggles.ESPHP.Value and hum then
        local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        local bw2, bx = 3, tl.X - 7
        if c.hBo then
            c.hBo.Position = Vector2.new(bx - 1, tS.Y - 1)
            c.hBo.Size = Vector2.new(bw2 + 2, bH + 2)
            c.hBo.Visible = true
        end
        if c.hBg then
            c.hBg.Position = Vector2.new(bx, tS.Y)
            c.hBg.Size = Vector2.new(bw2, bH)
            c.hBg.Visible = true
        end
        if c.hFi then
            local fh = bH * pct
            c.hFi.Position = Vector2.new(bx, tS.Y + (bH - fh))
            c.hFi.Size = Vector2.new(bw2, fh)
            c.hFi.Color = Options.ESPHPCol.Value
            c.hFi.Visible = true
        end
    else
        if c.hBg then c.hBg.Visible = false end
        if c.hBo then c.hBo.Visible = false end
        if c.hFi then c.hFi.Visible = false end
    end

    if Toggles.ESPTracer.Value then
        local vp = Camera.ViewportSize
        local from
        local o = Options.ESPTracFrom.Value
        if o == "Top" then from = Vector2.new(vp.X / 2, 0)
        elseif o == "Middle" then from = Vector2.new(vp.X / 2, vp.Y / 2)
        else from = Vector2.new(vp.X / 2, vp.Y) end
        if c.trO then c.trO.From = from; c.trO.To = bS; c.trO.Visible = true end
        if c.tr then c.tr.From = from; c.tr.To = bS; c.tr.Color = Options.ESPTracCol.Value; c.tr.Visible = true end
    else
        if c.tr then c.tr.Visible = false end
        if c.trO then c.trO.Visible = false end
    end
end

local function addHL(p)
    if p == LocalPlayer then return end
    local function onChar(ch)
        pcall(function()
            if Highlights[p] then Highlights[p]:Destroy() end
        end)
        local hl = Instance.new("Highlight")
        hl.Name = "OHL"
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0
        hl.Adornee = ch
        hl.Enabled = false
        hl.Parent = ch
        Highlights[p] = hl
        if HasDrawing then makeCache(p) end
    end
    if p.Character then onChar(p.Character) end
    p.CharacterAdded:Connect(onChar)
end

local function removeHL(p)
    pcall(function()
        if Highlights[p] then Highlights[p]:Destroy() end
    end)
    Highlights[p] = nil
    removeCache(p)
    EnemyHP[p] = nil
    PrevAliveState[p] = nil
    _tcache[p] = nil
end

