        CONFIG[t.rainbow] = not CONFIG[t.rainbow]
        refreshAll()
    end)

    local resetBtn = Instance.new("TextButton")
    resetBtn.Size = UDim2.new(1, -20, 0, 28); resetBtn.Position = UDim2.new(0, 10, 1, -38)
    resetBtn.BackgroundColor3 = COL.bgTertiary
