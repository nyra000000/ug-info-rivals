        local indicator = Instance.new("Frame")
        indicator.Size = UDim2.new(0, 3, 0, 0); indicator.Position = UDim2.new(0, 0, 0.5, 0)
        indicator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        indicator.BorderSizePixel = 0; indicator.Parent = btn
        local ic2 = Instance.new("UICorner"); ic2.CornerRadius = UDim.new(0, 3); ic2.Parent = indicator

        local iconLabel = Instance.new("TextLabel")
        iconLabel.Size = UDim2.new(0, 28, 1, 0); iconLabel.Position = UDim2.new(0, 10, 0, 0)
        iconLabel.BackgroundTransparency = 1; iconLabel.Text = icon
        iconLabel.TextColor3 = COLORS.textDim; iconLabel.Font = Enum.Font.GothamBold
        iconLabel.TextSize = 17; iconLabel.Parent = btn

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -48, 1, 0); lbl.Position = UDim2.new(0, 42, 0, 0)
        lbl.BackgroundTransparency = 1; lbl.Text = label
        lbl.TextColor3 = COLORS.textDim; lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 12; lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = btn

        btn.MouseButton1Click:Connect(function()
            for _, b in pairs(sidebarButtons) do
                b:SetAttribute("active", false)
                b.BackgroundColor3 = COLORS.bgSecondary
                for _, child in ipairs(b:GetChildren()) do
                    if child:IsA("TextLabel") then child.TextColor3 = COLORS.textDim end
                    if child:IsA("Frame") and child.Name ~= "IconFrame" then
                        child.Size = UDim2.new(0, 3, 0, 0)
                    end
                end
            end
            btn:SetAttribute("active", true)
            btn.BackgroundColor3 = COLORS.bgTertiary
            indicator.Size = UDim2.new(0, 3, 0, 22)
            for _, child in ipairs(btn:GetChildren()) do
                if child:IsA("TextLabel") then child.TextColor3 = COLORS.accent end
            end
            for name, p in pairs(pages) do p.frame.Visible = (name == pageName) end
        end)

        table.insert(sidebarButtons, btn)
        return btn
