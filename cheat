local function spawnImpact(pos, color)
    if not Toggles.BTImpact.Value or Options.BTImpFX.Value == "None" then return end
    pcall(function()
        local col = color
        local sz = Options.BTImpSz.Value
        local fx = Options.BTImpFX.Value
        if fx == "Glow" then
            local g = Instance.new("Part")
            g.Size = Vector3.new(2, 2, 2) * sz
            g.Shape = Enum.PartType.Ball
            g.Material = Enum.Material.Neon
            g.Anchored = true; g.CanCollide = false; g.Color = col; g.Transparency = 0.2
            g.CFrame = CFrame.new(pos); g.Parent = workspace
            TweenService:Create(g, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(4, 4, 4) * sz}):Play()
            Debris:AddItem(g, 0.6)
            return
        end
        if fx == "Ring" then
            for i = 1, 16 do
                local p = Instance.new("Part")
                p.Size = Vector3.new(0.2, 0.2, 0.2) * sz
                p.Shape = Enum.PartType.Ball
                p.Material = Enum.Material.Neon
                p.Anchored = true; p.CanCollide = false; p.Color = col
                local a = (i / 16) * math.pi * 2
                p.CFrame = CFrame.new(pos + Vector3.new(math.cos(a) * 3 * sz, math.sin(a) * 3 * sz, 0))
                p.Parent = workspace
                TweenService:Create(p, TweenInfo.new(0.4), {Transparency = 1, Size = Vector3.new(0.05, 0.05, 0.05) * sz}):Play()
                Debris:AddItem(p, 0.5)
            end
            return
        end
        local count = (fx == "Confetti" and 15) or (fx == "Sparkle" and 12) or 8
        for i = 1, count do
            local p = Instance.new("Part")
            p.Size = Vector3.new(0.3, 0.3, 0.3) * sz
            p.Shape = Enum.PartType.Ball
            p.Material = Enum.Material.Neon
            p.Anchored = true; p.CanCollide = false; p.Transparency = 0.2
            if fx == "Confetti" then p.Color = Color3.fromHSV(math.random(), 0.8, 1)
            elseif fx == "Fire" then p.Color = Color3.fromHSV(math.random(0, 10) / 100, 1, 1)
            elseif fx == "Ice" then p.Color = Color3.fromRGB(200, 230, 255); p.Material = Enum.Material.Ice
            elseif fx == "Smoke" then p.Color = Color3.fromRGB(100, 100, 100); p.Material = Enum.Material.SmoothPlastic
            else p.Color = col end
            p.CFrame = CFrame.new(pos + Vector3.new(math.random(-3, 3), math.random(-3, 3), math.random(-3, 3)) * sz)
            p.Parent = workspace
            TweenService:Create(p, TweenInfo.new(0.5), {Transparency = 1, Size = Vector3.new(0.05, 0.05, 0.05) * sz}):Play()
            Debris:AddItem(p, 0.7)
        end
    end)
end

