local function enableRapidFire()
    if RapidFireState.enabled then return end
    local ok, lib = pcall(function() return require(ReplicatedStorage.Modules.ItemLibrary) end)
    if not ok or not lib then print("[RapidFire] ItemLibrary introuvable!"); return end
    RapidFireState.originals = {}
    local function scan(tbl, depth)
        depth = depth or 0
        if depth > 6 then return end
        for _, v in pairs(tbl) do
            if typeof(v) == "table" then
                local saved = {}
                for _, key in ipairs({"ShootCooldown","BurstCooldown","AttackCooldown","HeavyAttackCooldown","FireRate","Cooldown","Rate"}) do
                    local val = v[key]
                    if val ~= nil and type(val) == "number" then
                        saved[key] = val
                        pcall(function() v[key] = 0.0000000001 end)
                    end
                end
                if next(saved) then RapidFireState.originals[v] = saved end
                scan(v, depth + 1)
            end
        end
    end
    scan(lib)
    if not next(RapidFireState.originals) then print("[RapidFire] Aucune propriété"); return end
    RapidFireState.enabled = true
    local count = 0
    for _ in pairs(RapidFireState.originals) do count = count + 1 end
    print("[RapidFire] Activé (" .. count .. " items)")
end

local function disableRapidFire()
    if not RapidFireState.enabled then return end
    for tbl, saved in pairs(RapidFireState.originals) do
        for key, val in pairs(saved) do pcall(function() tbl[key] = val end) end
    end
    RapidFireState.originals = {}
    RapidFireState.enabled = false
    print("[RapidFire] Désactivé")
end

