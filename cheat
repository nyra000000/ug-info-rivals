local Memory = { has_memory = (readmemory ~= nil and writememory ~= nil and getinstanceaddress ~= nil) }
if Memory.has_memory then
    Memory.read = function(addr, kind) local ok, val = pcall(readmemory, addr, kind or "float"); return ok and val or nil end
    Memory.write = function(addr, val, kind) return pcall(writememory, addr, val, kind or "float") end
    Memory.getaddr = function(inst) local ok, addr = pcall(getinstanceaddress, inst); return ok and addr or nil end
    print("[CulHook] Memory access activé")
else
    print("[CulHook] Memory access indisponible — fallback API Roblox")
end

local function safeGetHumanoidField(hum, field, default)
    if not hum then return default end
    if Memory.has_memory and Memory.getaddr and OFF.Humanoid[field] then
        local addr = Memory.getaddr(hum)
        if addr then
            local v = Memory.read(addr + OFF.Humanoid[field], "float")
            if v then return v end
        end
    end
    local ok, v = pcall(function() return hum[field] end)
    if ok then return v end
    return default
end

local function safeSetHumanoidField(hum, field, value)
    if not hum then return false end
    if Memory.has_memory and Memory.getaddr and OFF.Humanoid[field] then
        local addr = Memory.getaddr(hum)
        if addr then local ok = Memory.write(addr + OFF.Humanoid[field], value, "float"); if ok then return true end end
    end
    pcall(function() hum[field] = value end)
    return true
end

local function safeSetCameraFOV(fov)
    if Memory.has_memory and Memory.getaddr then
        local addr = Memory.getaddr(Camera)
        if addr then local ok = Memory.write(addr + OFF.Camera.FieldOfView, fov, "float"); if ok then return true end end
    end
    pcall(function() Camera.FieldOfView = fov end)
    return true
end

local function safeSetGravity(g)
    if Memory.has_memory and Memory.getaddr then
        local ws_addr = Memory.getaddr(workspace)
        if ws_addr then
            local world_addr = Memory.read(ws_addr + OFF.Workspace.World, "pointer")
            if world_addr then local ok = Memory.write(world_addr + OFF.World.Gravity, g, "float"); if ok then return true end end
        end
    end
    pcall(function() workspace.Gravity = g end)
    return true
end

local function safeSetLighting(prop, value)
    if Memory.has_memory and Memory.getaddr and OFF.Lighting[prop] then
        local addr = Memory.getaddr(Lighting)
        if addr then
            local kind = (typeof(value) == "Color3") and "Color3" or "float"
            local ok = Memory.write(addr + OFF.Lighting[prop], value, kind)
            if ok then return true end
        end
    end
    pcall(function() Lighting[prop] = value end)
    return true
end

