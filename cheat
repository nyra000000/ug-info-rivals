        GeographicLatitude = pcall(function() return Lighting.GeographicLatitude end) and Lighting.GeographicLatitude or 41.7,
    }
end

local function applyAmbience(index)
    local preset = AmbiencePresets[index]
    if not preset then return end
    local props = preset.Properties
    pcall(function()
        if props.Ambient then Lighting.Ambient = props.Ambient end
        if props.Brightness then Lighting.Brightness = props.Brightness end
        if props.ColorShift_Bottom then Lighting.ColorShift_Bottom = props.ColorShift_Bottom end
        if props.ColorShift_Top then Lighting.ColorShift_Top = props.ColorShift_Top end
        if props.EnvironmentDiffuseScale then Lighting.EnvironmentDiffuseScale = props.EnvironmentDiffuseScale end
        if props.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = props.EnvironmentSpecularScale end
        if props.ExposureCompensation then Lighting.ExposureCompensation = props.ExposureCompensation end
        if props.FogColor then Lighting.FogColor = props.FogColor end
        if props.FogEnd then Lighting.FogEnd = props.FogEnd end
        if props.FogStart then Lighting.FogStart = props.FogStart end
        if props.GlobalShadows ~= nil then Lighting.GlobalShadows = props.GlobalShadows end
        if props.OutdoorAmbient then Lighting.OutdoorAmbient = props.OutdoorAmbient end
        if props.ShadowSoftness then Lighting.ShadowSoftness = props.ShadowSoftness end
        if props.ClockTime then Lighting.ClockTime = props.ClockTime end
        if props.GeographicLatitude then Lighting.GeographicLatitude = props.GeographicLatitude end
    end)
    CurrentAmbience = index
    Library:Notify({Title = "Ambience", Description = "Applied: " .. preset.Name, Time = 2})
end

local function restoreAmbience()
    pcall(function()
        if OrigLighting.Ambient then Lighting.Ambient = OrigLighting.Ambient end
        if OrigLighting.Brightness then Lighting.Brightness = OrigLighting.Brightness end
        if OrigLighting.ColorShift_Bottom then Lighting.ColorShift_Bottom = OrigLighting.ColorShift_Bottom end
        if OrigLighting.ColorShift_Top then Lighting.ColorShift_Top = OrigLighting.ColorShift_Top end
        if OrigLighting.EnvironmentDiffuseScale then Lighting.EnvironmentDiffuseScale = OrigLighting.EnvironmentDiffuseScale end
        if OrigLighting.EnvironmentSpecularScale then Lighting.EnvironmentSpecularScale = OrigLighting.EnvironmentSpecularScale end
        if OrigLighting.ExposureCompensation then Lighting.ExposureCompensation = OrigLighting.ExposureCompensation end
        if OrigLighting.FogColor then Lighting.FogColor = OrigLighting.FogColor end
        if OrigLighting.FogEnd then Lighting.FogEnd = OrigLighting.FogEnd end
        if OrigLighting.FogStart then Lighting.FogStart = OrigLighting.FogStart end
        if OrigLighting.GlobalShadows ~= nil then Lighting.GlobalShadows = OrigLighting.GlobalShadows end
        if OrigLighting.OutdoorAmbient then Lighting.OutdoorAmbient = OrigLighting.OutdoorAmbient end
        if OrigLighting.ShadowSoftness then Lighting.ShadowSoftness = OrigLighting.ShadowSoftness end
        if OrigLighting.ClockTime then Lighting.ClockTime = OrigLighting.ClockTime end
        if OrigLighting.GeographicLatitude then Lighting.GeographicLatitude = OrigLighting.GeographicLatitude end
