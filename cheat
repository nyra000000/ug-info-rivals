        local bc = Instance.new("UICorner"); bc.CornerRadius = UDim.new(0, 6); bc.Parent = btn
        local bs = Instance.new("UIStroke"); bs.Color = COL.border; bs.Thickness = 1; bs.Parent = btn

        UI_REFS[keyName] = function(v) btn.Text = v end

        btn.MouseButton1Click:Connect(function()
            btn.Text = "…"
            btn.TextColor3 = COL.textSub
            task.wait(0.1)
            if isTrigger then
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        CONFIG.TriggerBotKey = input.KeyCode
                        CONFIG.TriggerBotKeyName = input.KeyCode.Name
                        CONFIG.TriggerBotKeyIsMouse = false
                        btn.Text = input.KeyCode.Name; btn.TextColor3 = COL.accent
                        conn:Disconnect()
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
                        CONFIG.TriggerBotKey = Enum.UserInputType.MouseButton1
                        CONFIG.TriggerBotKeyName = "MB1"
                        CONFIG.TriggerBotKeyIsMouse = true
                        btn.Text = "MB1"; btn.TextColor3 = COL.accent
                        conn:Disconnect()
                    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
                        CONFIG.TriggerBotKey = Enum.UserInputType.MouseButton2
                        CONFIG.TriggerBotKeyName = "MB2"
                        CONFIG.TriggerBotKeyIsMouse = true
                        btn.Text = "MB2"; btn.TextColor3 = COL.accent
                        conn:Disconnect()
                    end
                end)
            elseif isTps then
                local conn
                conn = UserInputService.InputBegan:Connect(function(input, gpe)
                    if gpe then return end
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        CONFIG.ThirdPersonKey = input.KeyCode
                        CONFIG.ThirdPersonKeyName = input.KeyCode.Name
                        btn.Text = input.KeyCode.Name; btn.TextColor3 = COL.accent
                        conn:Disconnect()
                    end
                end)
            else
                waitingForKeybind = true
                keybindCallback = function(name) btn.Text = name; btn.TextColor3 = COL.accent end
            end
        end)

        return row
    end

