local function isTargetValid(p, maxDist, useDeadCheck, useTeamCheck, useVisCheck)
    if not p or not p.Character then return false end
    if p == LocalPlayer then return false end
    if not isAlive(p, useDeadCheck) then return false end
    if useTeamCheck and not isEnemy(p, true) then return false end
    local ch = p.Character
    local root = ch:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    if maxDist and dist3(Camera.CFrame.Position, root.Position) > maxDist then return false end
    if useVisCheck then
        local part = getPart(ch, Options.AimPart.Value)
        if not part or not isVisible(Camera.CFrame.Position, part) then return false end
    end
    return true
end

local function findTarget()
    local best, bestD = nil, Options.AimFOV.Value
    local ctr = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camP = Camera.CFrame.Position
    local useTeamCheck = Toggles.AimTeamCheck and Toggles.AimTeamCheck.Value
    local useDeadCheck = Toggles.AimDeadCheck and Toggles.AimDeadCheck.Value
    local useVisCheck = Toggles.AimVisCheck and Toggles.AimVisCheck.Value
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not isAlive(p, useDeadCheck) then continue end
        if useTeamCheck and not isEnemy(p, true) then continue end
        local ch = p.Character
        if not ch then continue end
        local part = getPart(ch, Options.AimPart.Value)
        if not part then continue end
        if dist3(camP, part.Position) > Options.AimDist.Value then continue end
        if useVisCheck and not isVisible(camP, part) then continue end
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if on then
            local d = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
            if d < bestD then
                bestD = d
                best = p
            end
        end
    end
    return best
end

local function aimAt(tgt)
    if not tgt or not tgt.Character then return end
    local part = getPart(tgt.Character, Options.AimPart.Value)
    if not part then return end
    
    if Toggles.AimSticky.Value then
        if StickyTarget ~= tgt then
            StickyTarget = tgt
            StickyLocked = true
            StickyLostTime = tick()
        end
    end
    
    local predictAmt = Options.AimPredict and Options.AimPredict.Value or 0
    local aimPos = part.Position
    if predictAmt > 0 then
        aimPos = getPredictedPosition(part, predictAmt)
    end
    
    local sp, on = Camera.WorldToViewportPoint(aimPos)
    if not on then return end
    local vp = Camera.ViewportSize
    local delta = Vector2.new(sp.X, sp.Y) - Vector2.new(vp.X / 2, vp.Y / 2)
    
    local sm
    if Toggles.AimMouseHard.Value then
        sm = 1
    else
        sm = Options.AimSm.Value
    end
    if Toggles.AimSticky.Value and StickyLocked then
        sm = sm * (1 - Options.AimStickyStr.Value)
    end
    sm = math.clamp(sm, 1, 20)
    
    local mag = delta.Magnitude
    if mag < 0.5 then return end
    
    mousemoverel(math.floor(delta.X / sm), math.floor(delta.Y / sm))
end

