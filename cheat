local function stopScope()
    if not ScopeActive then return end
    ScopeActive = false
    if Toggles.ScopeReset.Value then
        if Toggles.ScopeSmooth.Value then
            if ScopeTween then ScopeTween:Cancel() end
            ScopeTween = TweenService:Create(Camera, TweenInfo.new(Options.ScopeSpeed.Value, Enum.EasingStyle.Quad), {FieldOfView = ScopeOrigFOV})
            ScopeTween:Play()
        else
            Camera.FieldOfView = ScopeOrigFOV
        end
    end
end

