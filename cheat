    ThirdPerson.connection = RunService.RenderStepped:Connect(function()
        if not ThirdPerson.enabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local dist = (Options.TPDistance and Options.TPDistance.Value) or 8
        local height = (Options.TPHeight and Options.TPHeight.Value) or 0
        local shoulder = (Options.TPShoulder and Options.TPShoulder.Value) or 0
        local camCF = Camera.CFrame
        local flatDir = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if flatDir.Magnitude < 0.01 then flatDir = Vector3.new(0,0,1) end
