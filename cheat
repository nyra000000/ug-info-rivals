local ThirdPersonState = { Applied=false, SavedTransparency={}, SavedDecals={} }

local function showLocalCharacter()
    local char = LP.Character
    if not char then return end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("BasePart") then
            if ThirdPersonState.SavedTransparency[desc] == nil then
                ThirdPersonState.SavedTransparency[desc] = desc.LocalTransparencyModifier
            end
            desc.LocalTransparencyModifier = 0
        end
        if desc:IsA("Decal") or desc:IsA("Texture") then
            if ThirdPersonState.SavedDecals[desc] == nil then
                ThirdPersonState.SavedDecals[desc] = desc.Transparency
            end
            desc.Transparency = 0
        end
    end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("BasePart") then
                    if ThirdPersonState.SavedTransparency[desc] == nil then
                        ThirdPersonState.SavedTransparency[desc] = desc.LocalTransparencyModifier
                    end
                    desc.LocalTransparencyModifier = 0
                end
            end
        end
    end
end

local function restoreLocalCharacter()
    local char = LP.Character
    if char then
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("BasePart") and ThirdPersonState.SavedTransparency[desc] ~= nil then
                desc.LocalTransparencyModifier = ThirdPersonState.SavedTransparency[desc]
            end
            if (desc:IsA("Decal") or desc:IsA("Texture")) and ThirdPersonState.SavedDecals[desc] ~= nil then
                desc.Transparency = ThirdPersonState.SavedDecals[desc]
            end
        end
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Tool") then
                for _, desc in ipairs(obj:GetDescendants()) do
                    if desc:IsA("BasePart") and ThirdPersonState.SavedTransparency[desc] ~= nil then
                        desc.LocalTransparencyModifier = ThirdPersonState.SavedTransparency[desc]
                    end
                end
            end
        end
    end
    ThirdPersonState.SavedTransparency = {}
    ThirdPersonState.SavedDecals = {}
end

local function computeThirdPersonCFrame()
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return nil end
    local dist = CONFIG.ThirdPersonDistance or 12
    local height = CONFIG.ThirdPersonHeight or 3
    local camDir = Camera.CFrame.LookVector
    local offset = Vector3.new(0, height, 0) + (-camDir * dist)
    local targetPos = hrp.Position + offset
    return CFrame.new(targetPos, hrp.Position + Vector3.new(0, 1.5, 0))
end

applyThirdPerson = function(enable)
    CONFIG.ThirdPersonActive = enable
    ThirdPersonState.Applied = enable
    if not enable then restoreLocalCharacter() end
end

RunService.RenderStepped:Connect(function()
    if not CONFIG.ThirdPersonActive then return end
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if CONFIG.ThirdPersonShowBody then pcall(showLocalCharacter) end
    local targetCF = computeThirdPersonCFrame()
    if not targetCF then return end
    if CONFIG.ThirdPersonSmooth then
        local speed = math.clamp(CONFIG.ThirdPersonSmoothSpeed or 0.15, 0.01, 1)
        Camera.CFrame = Camera.CFrame:Lerp(targetCF, speed)
    else
        Camera.CFrame = targetCF
    end
end)

LP.CharacterAdded:Connect(function()
    ThirdPersonState.SavedTransparency = {}
    ThirdPersonState.SavedDecals = {}
    if CONFIG.ThirdPersonActive then
        task.wait(0.5)
        pcall(showLocalCharacter)
    end
end)

