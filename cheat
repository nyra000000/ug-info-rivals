local AntiKatanaState = { enabled = false, visualize = false }

local function hasKatanaEquipped(plr)
    if not plr or not plr.Character then return false end
    local char = plr.Character
    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool.Name:lower():find("katana") then return true end

    local viewmodels = workspace:FindFirstChild("ViewModels")
    if viewmodels then
        local prefix = plr.Name .. " - Katana"
        for _, vm in ipairs(viewmodels:GetChildren()) do
            if vm.Name:sub(1, #prefix) == prefix then return true end
        end
        local fp = viewmodels:FindFirstChild("FirstPerson")
        if fp then
            for _, vm in ipairs(fp:GetChildren()) do
                if vm.Name:sub(1, #prefix) == prefix then return true end
            end
        end
    end

    local fighterCtrl = GENV._antiKatanaFighterController
    if not fighterCtrl then
        pcall(function()
            fighterCtrl = require(LocalPlayer.PlayerScripts.Controllers.FighterController)
            GENV._antiKatanaFighterController = fighterCtrl
        end)
    end
    if fighterCtrl then
        local ok, fighter = pcall(function() return fighterCtrl:GetFighter(plr) end)
        if ok and fighter then
            local equipped = fighter.EquippedItem
            if equipped and equipped.Name and equipped.Name:lower():find("katana") then return true end
        end
    end
    return false
end

