local RapidFireState = { enabled = false, originals = {}, itemLib = nil }

local function enableRapidFire()
    if RapidFireState.enabled then return end
    local ok, lib = pcall(function()
        return require(ReplicatedStorage.Modules.ItemLibrary)
    end)
    if not ok or not lib then
        Library:Notify({Title = "Rapid Fire", Description = "ItemLibrary introuvable!", Time = 3})
        return
    end
    RapidFireState.itemLib = lib
    RapidFireState.originals = {}
    local function scan(tbl)
        for _, v in pairs(tbl) do
            if typeof(v) == "table" then
                local saved = {}
                for _, key in ipairs({"ShootCooldown", "BurstCooldown", "AttackCooldown", "HeavyAttackCooldown"}) do
                    if v[key] ~= nil then
                        saved[key] = v[key]
                        v[key] = 0.000000000000000001
                    end
                end
                if next(saved) then RapidFireState.originals[v] = saved end
                scan(v)
            end
        end
    end
    scan(lib)
    RapidFireState.enabled = true
    Library:Notify({Title = "Rapid Fire", Description = "Activé", Time = 3})
end

local function disableRapidFire()
    if not RapidFireState.enabled then return end
    for tbl, saved in pairs(RapidFireState.originals) do
        for key, val in pairs(saved) do
            pcall(function() tbl[key] = val end)
        end
    end
    RapidFireState.originals = {}
    RapidFireState.enabled = false
    Library:Notify({Title = "Rapid Fire", Description = "Désactivé", Time = 2})
end

