local function getBonePositions(character)
    local bones = {}
    local names = {"Head","UpperTorso","LowerTorso","HumanoidRootPart","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
    for _, n in ipairs(names) do
        local part = character:FindFirstChild(n)
        if part then bones[n] = part end
    end
    return bones
end

local function updateEntry(plr, e)
    if plr.Character ~= e.lastChar then createEntry(plr); return end
    local on = isTarget(plr) and isAlive(plr)
    if not on then
        e.highlight.Enabled = false
        if e.box then e.box.Visible = false end
        if e.name then e.name.Visible = false end
        if e.dist then e.dist.Visible = false end
        if e.hbg then e.hbg.Visible = false end
        if e.hfg then e.hfg.Visible = false end
        if e.tracer then e.tracer.Visible = false end
        if e.bones then for _, b in ipairs(e.bones) do b.Visible = false end end
        return
    end
    local hrp = getHRP(plr); local hum = getHum(plr)
    if not hrp then return end
    local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
    local distStuds = (hrp.Position - Camera.CFrame.Position).Magnitude
    local wallOn = CONFIG.Enabled
    e.highlight.Enabled = wallOn and CONFIG.Highlight
    if e.highlight.Adornee ~= plr.Character then e.highlight.Adornee = plr.Character end
    if not CONFIG.FillRainbow then e.highlight.FillColor = CONFIG.FillColor end
    if not CONFIG.OutlineRainbow then e.highlight.OutlineColor = CONFIG.OutlineColor end
    e.highlight.FillTransparency = 1 - CONFIG.FillAlpha
    e.highlight.OutlineTransparency = 1 - CONFIG.OutlineAlpha
    if not (e.box and e.name and e.dist) then return end
    if not wallOn or not onScreen or distStuds > CONFIG.MaxDistance then
        e.box.Visible=false; e.name.Visible=false; e.dist.Visible=false
        if e.hbg then e.hbg.Visible = false end
        if e.hfg then e.hfg.Visible = false end
    else
        local scale = 1 / (pos.Z * 0.1 + 1)
        local w = math.clamp(40 * scale * 10, 8, 400)
        local h = math.clamp(70 * scale * 10, 12, 600)
        if CONFIG.Box then
            e.box.Size = Vector2.new(w, h); e.box.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
            if not CONFIG.BoxRainbow then e.box.Color = CONFIG.BoxColor end
            e.box.Visible = true
        else e.box.Visible = false end
        if CONFIG.Name then
            e.name.Position = Vector2.new(pos.X, pos.Y - h/2 - 16); e.name.Text = plr.Name
            if not CONFIG.NameRainbow then e.name.Color = CONFIG.NameColor end
            e.name.Visible = true
        else e.name.Visible = false end
        if CONFIG.Distance then
            e.dist.Position = Vector2.new(pos.X, pos.Y + h/2 + 2)
            e.dist.Text = string.format("%d studs", math.floor(distStuds))
            e.dist.Color = CONFIG.DistColor; e.dist.Visible = true
        else e.dist.Visible = false end
        if CONFIG.HealthBar and hum and e.hbg and e.hfg then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bw, bh = 3, h
            local bx = pos.X - w/2 - bw - 4
            local by = pos.Y - h/2
            e.hbg.Size = Vector2.new(bw, bh); e.hbg.Position = Vector2.new(bx, by); e.hbg.Visible = true
            local fh = bh * pct
            e.hfg.Size = Vector2.new(bw, fh); e.hfg.Position = Vector2.new(bx, by + (bh - fh))
            e.hfg.Color = Color3.fromRGB(255 * (1 - pct), 255 * pct, 0); e.hfg.Visible = true
        else
            if e.hbg then e.hbg.Visible = false end
            if e.hfg then e.hfg.Visible = false end
        end
    end
    if CONFIG.SkeletonEnabled and e.bones and onScreen then
        local bones = getBonePositions(plr.Character)
        local conns = {
            {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"LowerTorso","HumanoidRootPart"},
            {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
            {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
            {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
            {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
        }
        for i, c in ipairs(conns) do
            local a = bones[c[1]]; local b = bones[c[2]]
            if a and b and e.bones[i] then
                local pA, oA = Camera:WorldToViewportPoint(a.Position)
                local pB, oB = Camera:WorldToViewportPoint(b.Position)
                if oA and oB then
                    e.bones[i].From = Vector2.new(pA.X, pA.Y)
                    e.bones[i].To = Vector2.new(pB.X, pB.Y)
                    if not CONFIG.SkeletonRainbow then e.bones[i].Color = CONFIG.SkeletonColor end
                    e.bones[i].Visible = true
                else e.bones[i].Visible = false end
            else if e.bones[i] then e.bones[i].Visible = false end end
        end
    else
        if e.bones then for _, b in ipairs(e.bones) do b.Visible = false end end
    end
    if CONFIG.TracersEnabled and e.tracer and onScreen then
        e.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
        e.tracer.To = Vector2.new(pos.X, pos.Y)
        if not CONFIG.TracersRainbow then e.tracer.Color = CONFIG.TracersColor end
        e.tracer.Visible = true
    else if e.tracer then e.tracer.Visible = false end end
end

