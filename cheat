local BulletTracers = {}
local lastTracerTime = 0

local function getMuzzleWorldPosition()
    local char = LP.Character
    if not char then return Camera.CFrame.Position end
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            for _, name in ipairs({"Muzzle", "Barrel", "Tip", "FirePoint", "MuzzlePoint", "Handle"}) do
                local part = obj:FindFirstChild(name, true)
                if part and part:IsA("BasePart") and part.Transparency < 0.9 then
                    return part.Position
                end
            end
        end
    end
    for _, obj in ipairs(Camera:GetChildren()) do
        if obj:IsA("Model") or obj:IsA("Tool") or obj:IsA("Folder") then
            local n = obj.Name:lower()
            if n:find("viewmodel") or n:find("arms") or n:find("gun") or n:find("weapon") or n:find("fps") then
                for _, name in ipairs({"Muzzle", "Barrel", "Tip", "FirePoint", "MuzzlePoint"}) do
                    local part = obj:FindFirstChild(name, true)
                    if part and part:IsA("BasePart") and part.Transparency < 0.9 then return part.Position end
                end
                for _, desc in ipairs(obj:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        local dn = desc.Name:lower()
                        if dn:find("muzzle") or dn:find("barrel") then return desc.Position end
                    end
                end
            end
        end
    end
    return (Camera.CFrame * CFrame.new(0, -1, -2)).Position
end

local function getAimEndPosition()
    local origin = Camera.CFrame.Position
    local look = Camera.CFrame.LookVector
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {Camera}
    if LP.Character then table.insert(ignore, LP.Character) end
    params.FilterDescendantsInstances = ignore
    local result = Workspace:Raycast(origin, look * 2000, params)
    if result then return result.Position end
    return origin + look * 2000
end

local function fireBulletTracer(fromPos, toPos)
    if not CONFIG.BulletTracerEnabled then return end
    if not HAS_DRAWING then return end
    local now = tick()
    if now - lastTracerTime < (CONFIG.BulletTracerAntiSpam or 0.03) then return end
    lastTracerTime = now
    local line = Drawing.new("Line")
    line.Thickness = CONFIG.BulletTracerThickness
    line.Transparency = 1
    line.Visible = true
    line.Color = CONFIG.BulletTracerColor
    table.insert(BulletTracers, { line=line, from=fromPos, to=toPos, born=tick(), lifetime=CONFIG.BulletTracerLifetime })
end

local function spawnBulletTracer()
    local from = getMuzzleWorldPosition()
    local to = getAimEndPosition()
    fireBulletTracer(from, to)
end

RunService.RenderStepped:Connect(function()
    if #BulletTracers == 0 then return end
    local now = tick()
    for i = #BulletTracers, 1, -1 do
        local t = BulletTracers[i]
        if not t.line then table.remove(BulletTracers, i)
        else
            local age = now - t.born
            if age >= t.lifetime then
                pcall(function() t.line:Remove() end)
                table.remove(BulletTracers, i)
            else
                local pFrom, onFrom = Camera:WorldToViewportPoint(t.from)
                local pTo, onTo = Camera:WorldToViewportPoint(t.to)
                if onFrom and onTo then
                    t.line.From = Vector2.new(pFrom.X, pFrom.Y)
                    t.line.To = Vector2.new(pTo.X, pTo.Y)
                    t.line.Transparency = math.clamp(1 - (age / t.lifetime), 0, 1)
                    t.line.Visible = true
                else t.line.Visible = false end
            end
        end
    end
end)

local detectedRemoteNames = { "fire", "shoot", "bullet", "cast", "ray", "projectile", "hit", "attack", "weapon", "gun", "tracer", "shot", "blast" }
