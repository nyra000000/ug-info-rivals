-- AIM HELPERS — Prédiction de position
-- =============================================
local function getVelocity(root)
    if not root then return Vector3.zero end
    local ok, v = pcall(function() return root.AssemblyLinearVelocity end)
    if ok and v then return v end
    return root.Velocity or Vector3.zero
end

local function getPredictedPosition(targetPart, predictAmount)
    if not targetPart then return nil end
    if not predictAmount or predictAmount <= 0 then return targetPart.Position end
    local root = targetPart.Parent and targetPart.Parent:FindFirstChild("HumanoidRootPart")
    if not root then return targetPart.Position end
    local vel = getVelocity(root)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myVel = myRoot and getVelocity(myRoot) or Vector3.zero
    local relVel = vel - myVel
    local dist = (targetPart.Position - Camera.CFrame.Position).Magnitude
    local travelTime = dist / 1000
    local lead = relVel * travelTime * predictAmount
    return targetPart.Position + lead
end

