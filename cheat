-- ============================================================
-- AIMBOT — Lock Speed = vrai facteur de collage
-- ============================================================
local AimState = {
    LastPos = {},
    CurrentTarget = nil,
}

local function isAimDistanceOk(targetPart)
    if not targetPart then return false end
    if CONFIG.AimMaxDistance <= 0 then return true end
    local myPos = Camera.CFrame.Position
    return (targetPart.Position - myPos).Magnitude <= CONFIG.AimMaxDistance
end

local function getClosestEnemy_ScreenFOV()
    local closest, shortest = nil, CONFIG.AimFOV
    local closestPlr = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChild("Humanoid")
            local tp = getAimPart(char)
            if hum and tp and hum.Health > 0 then
                if not isAimDistanceOk(tp) then continue end
                if CONFIG.AimVisibleCheck and not isVisible(tp) then continue end
                local sp = Camera:WorldToViewportPoint(tp.Position)
                if sp.Z > 0 then
                    local mp = UserInputService:GetMouseLocation()
                    local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mp.X, mp.Y)).Magnitude
                    if d < shortest then shortest = d; closest = tp; closestPlr = plr end
                end
            end
        end
    end
    return closest, closestPlr
end

local function getClosestEnemy_360FOV()
    local closest, shortest = nil, math.huge
    local closestPlr = nil
    local myPos = Camera.CFrame.Position
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local char = plr.Character
            local hum = char:FindFirstChild("Humanoid")
            local tp = getAimPart(char)
            if hum and tp and hum.Health > 0 then
                if not isAimDistanceOk(tp) then continue end
                if CONFIG.AimVisibleCheck and not isVisible(tp) then continue end
                local d = (tp.Position - myPos).Magnitude
                if d < shortest then shortest = d; closest = tp; closestPlr = plr end
            end
        end
    end
    return closest, closestPlr
end

local function getClosestEnemy()
    if CONFIG.Aim360FOV then return getClosestEnemy_360FOV()
    else return getClosestEnemy_ScreenFOV() end
end

-- aimAt : le lock speed contrôle vraiment le "collage"
-- 0    = pas d'aim (ignore)
-- 0.5  = suit doucement
-- 1.0  = tracking parfait + prédiction de vélocité
local function aimAt(target, targetPlr)
    if not target then return end

    local lock = math.clamp(CONFIG.AimLockSpeed or 0.5, 0, 1)
    if lock <= 0 then return end

    -- Prédiction de vélocité quand lock élevé
    local targetPos = target.Position
    if CONFIG.AimPrediction and targetPlr and lock > 0.6 then
        local prev = AimState.LastPos[targetPlr]
        if prev then
            local velocity = target.Position - prev
            -- facteur de prédiction : 0 à 2 frames d'avance selon lock
            local predictFactor = (lock - 0.6) / 0.4 * 2.0  -- 0 à 2
            targetPos = target.Position + velocity * predictFactor
        end
        AimState.LastPos[targetPlr] = target.Position
    end

    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local sp, onScreen = Camera:WorldToViewportPoint(targetPos)
    if not CONFIG.Aim360FOV and not onScreen then return end

    local dx = (sp.X - center.X)
    local dy = (sp.Y - center.Y)
    if sp.Z < 0 then dx = -dx; dy = -dy end

    -- multiplicateur : lock direct, modulé par smoothness seulement si lock < 0.5
    local mult = lock
    if lock < 0.5 then
        local smooth = math.clamp(CONFIG.AimSmoothness or 0.5, 0, 1)
        mult = mult * (1 - smooth * 0.5)
    end

    local moveX = dx * mult
    local moveY = dy * mult

    -- cap maxStep : plus permissif quand lock monte, absent à 100%
    if lock < 1 then
        local maxStep = 60 + lock * 400 -- 60 → 460
        moveX = math.clamp(moveX, -maxStep, maxStep)
        moveY = math.clamp(moveY, -maxStep, maxStep)

        -- deadzone : diminue avec le lock, disparaît à 100%
        local deadzone = 0.6 * (1 - lock)
        if math.abs(moveX) < deadzone and math.abs(moveY) < deadzone then
            return
        end
    end

    if mousemoverel then
        mousemoverel(moveX, moveY)
    elseif syn and syn.mousemoverel then
        syn.mousemoverel(moveX, moveY)
    else
        local VIM = game:GetService("VirtualInputManager")
        if VIM then VIM:SendMouseMoveEvent(moveX, moveY, false) end
    end
end

