local function loadFromRepo(path)
    local urls = {
        "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/" .. path,
        "https://raw.githubusercontent.com/deividcomsono/Obsidian/master/" .. path,
        "https://cdn.jsdelivr.net/gh/deividcomsono/Obsidian@main/" .. path,
        "https://cdn.jsdelivr.net/gh/deividcomsono/Obsidian@master/" .. path,
    }
    for _, url in ipairs(urls) do
        local ok, src = pcall(function() return game:HttpGet(url, true) end)
        if ok and type(src) == "string" and #src > 200 then
            local ok2, fn = pcall(loadstring, src)
            if ok2 and type(fn) == "function" then
                local ok3, res = pcall(fn)
                if ok3 and res ~= nil then return res end
            end
        end
    end
    return nil
end

