                    if mt and typeof(mt) == "table" and rawget(mt, "__mode") == "kv" then
                        local tr = debug.traceback()
                        if tr:find("MiscellaneousController") then
                            return _stbl({1,2,3}, {})
                        end
                    end
                    return _stbl(tbl, mt)
                end))
            end)
        else
            pcall(function()
                local function _proc(o)
                    pcall(function()
                        if o:IsA("LocalScript") or o:IsA("ModuleScript") then
                            local nm = o.Name:lower()
                            local _tags = {"anticheat","detection","ban","kick","security","moderation"}
                            for _i = 1, #_tags do
                                if nm:find(_tags[_i]) then
                                    pcall(function() o.Disabled = true end)
                                    break
                                end
                            end
                        end
                    end)
                end
                for _, o in ipairs(game:GetDescendants()) do _proc(o) end
                game.DescendantAdded:Connect(_proc)
            end)
        end
        
        -- ===== AC bypass ReplicatedFirst =====
        pcall(function()
            local _rf = game:GetService("ReplicatedFirst")
            local _tgt = _rf:FindFirstChild("LocalScript3")
            if not _tgt then return end
            if EXEC.has_getgc and EXEC.has_hookfunction then
                local _gc = getgc(false)
                for _i = 1, #_gc do
                    local _fn = _gc[_i]
                    if type(_fn) ~= "function" then continue end
                    local _ok1, _env = pcall(getfenv, _fn)
                    if not _ok1 or type(_env) ~= "table" then continue end
                    local _ok2, _scr = pcall(function() return rawget(_env, "script") end)
                    if not _ok2 or not _scr or typeof(_scr) ~= "Instance" then continue end
                    local _ok3, _ss = pcall(tostring, _scr)
                    if not _ok3 then continue end
                    if not (_scr == _tgt or (type(_ss) == "string" and _ss:find("LoadingScreen"))) then continue end
                    local _ok4, _consts = pcall(debug.getconstants, _fn)
                    if not _ok4 or type(_consts) ~= "table" then continue end
                    for _j = 1, #_consts do
                        local _c = _consts[_j]
                        if type(_c) == "string" and (_c:find("TakeTheL") or _c:find("ban") or _c:find("kick")) then
                            pcall(function() hookfunction(_fn, function() end) end)
                            break
                        end
                    end
                end
            end
        end)
        
        -- ===== ATTENTE ACTIVE DES MODULES DU JEU =====
        local _rs = game:GetService("ReplicatedStorage")
        local _http = game:GetService("HttpService")
        local _lp = game:GetService("Players").LocalPlayer
        local _pscripts = _lp.PlayerScripts
        
        Library:Notify({Title = "Unlock All", Description = "Waiting for game to load...", Time = 3})
        
        local _ctrl, _mods, _cosLib, _enumLib, _datCtrl
        
        local _waited = 0
        while true do
            _ctrl = _pscripts:FindFirstChild("Controllers")
            _mods = _rs:FindFirstChild("Modules")
            
            if _ctrl and _mods then
                local _cosMod = _mods:FindFirstChild("CosmeticLibrary")
                local _enumMod = _mods:FindFirstChild("EnumLibrary")
                local _datMod = _ctrl:FindFirstChild("PlayerDataController")
                
                if _cosMod and _enumMod and _datMod then
                    local _okAll = true
                    
                    if not _enumLib then
                        local _ok, _res = pcall(require, _enumMod)
                        if _ok then _enumLib = _res else _okAll = false end
                    end
                    if _okAll and not _cosLib then
                        local _ok, _res = pcall(require, _cosMod)
                        if _ok then _cosLib = _res else _okAll = false end
                    end
                    if _okAll and not _datCtrl then
                        local _ok, _res = pcall(require, _datMod)
                        if _ok then _datCtrl = _res else _okAll = false end
                    end
                    
                    if _okAll and _cosLib and _cosLib.Cosmetics then
                        if _enumLib and _enumLib.WaitForEnumBuilder then
                            pcall(function() _enumLib:WaitForEnumBuilder() end)
                        end
                        
                        local _hasData = false
                        local _count = 0
                        for _k, _v in pairs(_cosLib.Cosmetics) do
                            _hasData = true
                            _count = _count + 1
                            if _count >= 10 then break end
                        end
                        
                        if _hasData then
                            break
                        end
                    end
                end
            end
            
            _waited = _waited + 1
            if _waited == 1 or _waited % 5 == 0 then
                Library:Notify({Title = "Unlock All", Description = "Waiting... (" .. _waited .. "s)", Time = 2})
            end
            task.wait(1)
        end
        
        Library:Notify({Title = "Unlock All", Description = "Game ready! Applying...", Time = 3})
        task.wait(1)
        
        -- ===== TABLES ET FONCTIONS =====
        local _eq, _favs = UnlockAllData.eq, UnlockAllData.favs
        local _buildingWep = nil
        
        local function _mkCosmetic(nm, ctype, opts)
            local _base = _cosLib.Cosmetics[nm]
            if not _base then return nil end
            local _d = {}
            for k, v in pairs(_base) do _d[k] = v end
            _d.Name = nm
            _d.Type = _d.Type or ctype
            _d.Seed = _d.Seed or math.random(1, 1000000)
            if _enumLib then
                local _s, _eid = pcall(_enumLib.ToEnum, _enumLib, nm)
                if _s and _eid then
                    _d.Enum = _eid
                    _d.ObjectID = _d.ObjectID or _eid
                end
            end
            return _d
        end
        
        local _cfgFile = "rivals_unlocker_config.json"
        local _saveLock = false
        
        local function _saveCfg()
            if not writefile or _saveLock then return end
            _saveLock = true
            task.spawn(function()
                task.wait(1)
                local _out = {}
                for wn, cos in pairs(_eq) do
                    _out[wn] = {}
                    for ct, cd in pairs(cos) do
                        if cd and cd.Name then
                            _out[wn][ct] = { Name = cd.Name }
                        end
                    end
                end
                local _ok, _enc = pcall(_http.JSONEncode, _http, { equipped = _out, favorites = _favs })
                if _ok then pcall(writefile, _cfgFile, _enc) end
                _saveLock = false
            end)
        end
        
        local function _loadCfg()
            if not readfile or not isfile then return 0, 0 end
            if not isfile(_cfgFile) then return 0, 0 end
            local _ok, _raw = pcall(readfile, _cfgFile)
            if not _ok or not _raw or _raw == "" then return 0, 0 end
            local _ok2, _data = pcall(_http.JSONDecode, _http, _raw)
            if not _ok2 or type(_data) ~= "table" then return 0, 0 end
            
            local _count, _missed = 0, 0
            if _data.equipped then
                for wn, cos in pairs(_data.equipped) do
                    _eq[wn] = _eq[wn] or {}
                    for ct, cd in pairs(cos) do
                        if cd and cd.Name then
                            local _cloned = _mkCosmetic(cd.Name, ct)
                            if _cloned then
                                _eq[wn][ct] = _cloned
                                _count = _count + 1
                            else
                                _missed = _missed + 1
                            end
                        end
                    end
                end
            end
            if _data.favorites then _favs = _data.favorites end
            return _count, _missed
        end
        
        local _loaded, _missed = _loadCfg()
        local _tries = 0
        while _missed and _missed > 0 and _tries < 10 do
            task.wait(2)
            _tries = _tries + 1
            for k in pairs(_eq) do _eq[k] = nil end
            _loaded, _missed = _loadCfg()
        end
        
        if _loaded and _loaded > 0 then
            Library:Notify({Title = "Unlock All", Description = "Config restaurée (" .. _loaded .. " cosmétiques)", Time = 4})
        else
            Library:Notify({Title = "Unlock All", Description = "Aucune config trouvée — déverrouille manuellement.", Time = 4})
        end
        
        local _cosTypes = {"Skin","Wrap","Charm","Dance","Emote"}
        local function _isCosType(cosObj)
            if not cosObj then return false end
            for _, t in ipairs(_cosTypes) do
                if cosObj.Type == t then return true end
            end
            return false
        end
        
        pcall(function()
            _cosLib.OwnsCosmeticNormally = function(self, inv, nm, wep)
                local c = _cosLib.Cosmetics[nm]
                if c and c.Type == "Skin" then return true end
                return false
            end
            _cosLib.OwnsCosmeticUniversally = function(self, inv, nm, wep)
                local c = _cosLib.Cosmetics[nm]
                if c and c.Type == "Skin" then return true end
                return false
            end
            _cosLib.OwnsCosmeticForWeapon = function(self, inv, nm, wep)
                local c = _cosLib.Cosmetics[nm]
                if c and c.Type == "Skin" then return true end
                return false
            end
            local _origOwns = _cosLib.OwnsCosmetic
            _cosLib.OwnsCosmetic = function(self, inv, nm, wep)
                if nm:find("MISSING_") or nm == "Bubble Gun" then
                    return _origOwns(self, inv, nm, wep)
                end
                local c = _cosLib.Cosmetics[nm]
                if c and _isCosType(c) then return true end
                return _origOwns(self, inv, nm, wep)
            end
        end)
        
        pcall(function()
            local _origGet = _datCtrl.Get
            _datCtrl.Get = function(self, key)
                local _val = _origGet(self, key)
                if key == "CosmeticInventory" then
                    local _prx = {}
                    if _val then
                        for k, v in pairs(_val) do
                            local c = _cosLib.Cosmetics[k]
                            if c and _isCosType(c) then _prx[k] = v end
                        end
                    end
                    return setmetatable(_prx, {
                        __index = function(t, k)
                            local c = _cosLib.Cosmetics[k]
                            if c and _isCosType(c) then return true end
                            return nil
                        end
                    })
                end
                if key == "FavoritedCosmetics" then
                    local _res = _val and table.clone(_val) or {}
                    for wep, fv in pairs(_favs) do
                        _res[wep] = _res[wep] or {}
                        for nm, isFav in pairs(fv) do
                            local c = _cosLib.Cosmetics[nm]
                            if c and _isCosType(c) then _res[wep][nm] = isFav end
                        end
                    end
                    return _res
                end
                return _val
            end
            
            local _origGetWep = _datCtrl.GetWeaponData
            _datCtrl.GetWeaponData = function(self, wn)
                local _d = _origGetWep(self, wn)
                if not _d then return nil end
                local _m = {}
                for k, v in pairs(_d) do _m[k] = v end
                _m.Name = wn
                if _eq[wn] then
                    for ct, cd in pairs(_eq[wn]) do _m[ct] = cd end
                end
                return _m
            end
        end)
        
        pcall(function()
            local _remotes = _rs:FindFirstChild("Remotes")
            local _dataRem = _remotes and _remotes:FindFirstChild("Data")
            local _equipRem = _dataRem and _dataRem:FindFirstChild("EquipCosmetic")
            
            if _equipRem and EXEC.has_hookmetamethod then
                local _onc
                _onc = hookmetamethod(game, "__namecall", function(self, ...)
                    if getnamecallmethod() ~= "FireServer" then return _onc(self, ...) end
                    local _a = {...}
                    if self == _equipRem then
                        local _wn = _a[1]
                        local _ct = _a[2]
                        local _cn = _a[3]
                        if _cn and _cn ~= "None" and _cn ~= "" then
                            _eq[_wn] = _eq[_wn] or {}
                            local _cloned = _mkCosmetic(_cn, _ct)
                            if _cloned then _eq[_wn][_ct] = _cloned end
                            task.defer(function()
                                pcall(function() _datCtrl.CurrentData:Replicate("WeaponInventory") end)
                            end)
                            _saveCfg()
                        end
                        return
                    end
                    return _onc(self, ...)
                end)
            end
        end)
        
        pcall(function()
            local _cliItem = require(_pscripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem)
            if _cliItem and _cliItem._CreateViewModel then
                local _origCVM = _cliItem._CreateViewModel
                _cliItem._CreateViewModel = function(self, vmRef)
                    local _wn = self.Name
                    local _wp = self.ClientFighter and self.ClientFighter.Player
                    _buildingWep = (_wp == _lp) and _wn or nil
                    if _wp == _lp and _eq[_wn] then
                        local _dk = self:ToEnum("Data")
                        if vmRef[_dk] then
                            if _eq[_wn].Skin then
                                vmRef[_dk][self:ToEnum("Skin")] = _eq[_wn].Skin
                                vmRef[_dk][self:ToEnum("Name")] = _eq[_wn].Skin.Name
                            end
                            if _eq[_wn].Charm then vmRef[_dk][self:ToEnum("Charm")] = _eq[_wn].Charm end
                            if _eq[_wn].Wrap then vmRef[_dk][self:ToEnum("Wrap")] = _eq[_wn].Wrap end
                        elseif vmRef.Data then
                            if _eq[_wn].Skin then vmRef.Data.Skin = _eq[_wn].Skin; vmRef.Data.Name = _eq[_wn].Skin.Name end
                            if _eq[_wn].Charm then vmRef.Data.Charm = _eq[_wn].Charm end
                            if _eq[_wn].Wrap then vmRef.Data.Wrap = _eq[_wn].Wrap end
                        end
                    end
                    local _r = _origCVM(self, vmRef)
                    _buildingWep = nil
                    return _r
                end
            end
            
            local _vmMod = _pscripts.Modules.ClientReplicatedClasses.ClientFighter.ClientItem:FindFirstChild("ClientViewModel")
            if _vmMod then
                local _CVM = require(_vmMod)
                local _origNew = _CVM.new
                _CVM.new = function(repData, cliItm)
                    local _wp = cliItm.ClientFighter and cliItm.ClientFighter.Player
                    local _wn = _buildingWep or cliItm.Name
                    if _wp == _lp and _eq[_wn] then
                        local _RC = require(_rs.Modules.ReplicatedClass)
                        local _dk = _RC:ToEnum("Data")
                        repData[_dk] = repData[_dk] or {}
                        local _cos = _eq[_wn]
                        if _cos.Skin then repData[_dk][_RC:ToEnum("Skin")] = _cos.Skin end
                        if _cos.Charm then repData[_dk][_RC:ToEnum("Charm")] = _cos.Charm end
                        if _cos.Wrap then repData[_dk][_RC:ToEnum("Wrap")] = _cos.Wrap end
                    end
                    return _origNew(repData, cliItm)
                end
            end
        end)
        
        Library:Notify({Title = "Unlock All", Description = "All cosmetics unlocked!", Time = 5})
        UnlockAll.initialized = true
        UnlockAll.running = false
        
        task.spawn(function()
            while UnlockAll.initialized do
                task.wait(30)
                _saveCfg()
            end
        end)
        
        LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1.5)
            if UnlockAll.initialized then
                pcall(function()
                    _datCtrl.CurrentData:Replicate("WeaponInventory")
                end)
            end
        end)
    end)
end

