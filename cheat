-- MISC — PERF BOOST
-- ============================================================
local PerfBoostState = {
    Applied = false,
    Conn = nil,
    OriginalParticles = {},
    OriginalTrails = {},
    OriginalBeams = {},
    MaxDistance = 150,
}

local function shouldPerfBoost(inst, ownerPart)
    if not ownerPart or not ownerPart.Parent then return false end
    local char = LP.Character
    if char and ownerPart:IsDescendantOf(char) then return false end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and ownerPart:IsDescendantOf(plr.Character) then
            return false
        end
    end
    local dist = (ownerPart.Position - Camera.CFrame.Position).Magnitude
    return dist > PerfBoostState.MaxDistance
end

local function applyPerfBoostToPart(part)
    if not part or not part.Parent then return end
    if not shouldPerfBoost(part, part) then return end

    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("ParticleEmitter") and child.Enabled then
            PerfBoostState.OriginalParticles[child] = true
            child.Enabled = false
        elseif child:IsA("Trail") and child.Enabled then
            PerfBoostState.OriginalTrails[child] = true
            child.Enabled = false
        elseif child:IsA("Beam") and child.Enabled then
            PerfBoostState.OriginalBeams[child] = true
            child.Enabled = false
        elseif child:IsA("Fire") or child:IsA("Smoke") or child:IsA("Sparkles") then
            child.Enabled = false
        end
    end
end

applyPerfBoost = function()
    if PerfBoostState.Conn then
        pcall(function() PerfBoostState.Conn:Disconnect() end)
        PerfBoostState.Conn = nil
    end
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") then
            applyPerfBoostToPart(desc)
        end
    end
    PerfBoostState.Conn = Workspace.DescendantAdded:Connect(function(desc)
        if desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
            task.wait(0.2)
            local parent = desc.Parent
            if parent and parent:IsA("BasePart") then
                if shouldPerfBoost(parent, parent) then
                    pcall(function() desc.Enabled = false end)
                end
            end
        end
    end)
    PerfBoostState.Applied = true
    CONFIG.MiscPerfBoost = true
    return true, "Perf Boost actif"
end

restorePerfBoost = function()
    if PerfBoostState.Conn then
        pcall(function() PerfBoostState.Conn:Disconnect() end)
        PerfBoostState.Conn = nil
    end
    for emitter in pairs(PerfBoostState.OriginalParticles) do
        if emitter and emitter.Parent then pcall(function() emitter.Enabled = true end) end
    end
    for trail in pairs(PerfBoostState.OriginalTrails) do
        if trail and trail.Parent then pcall(function() trail.Enabled = true end) end
    end
    for beam in pairs(PerfBoostState.OriginalBeams) do
        if beam and beam.Parent then pcall(function() beam.Enabled = true end) end
    end
    PerfBoostState.OriginalParticles = {}
    PerfBoostState.OriginalTrails = {}
    PerfBoostState.OriginalBeams = {}
    PerfBoostState.Applied = false
    CONFIG.MiscPerfBoost = false
end

