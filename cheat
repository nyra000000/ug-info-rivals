local TriggerBotState = { LastFire = 0, IsFiring = false }

local function simulateFire()
    local VIM = game:GetService("VirtualInputManager")
    if VIM then
        pcall(function()
            VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(CONFIG.TriggerBotHoldTime or 0.08)
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    else
        if mouse1click then pcall(mouse1click)
        elseif keypress and keyrelease then
            pcall(keypress, 0x01)
            task.wait(CONFIG.TriggerBotHoldTime or 0.08)
            pcall(keyrelease, 0x01)
        end
    end
end

local function getTargetUnderCrosshair()
    local mp = UserInputService:GetMouseLocation()
    if CONFIG.TriggerBot360 then
        local bestTarget, bestDist = nil, math.huge
        local myPos = Camera.CFrame.Position
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                local targetPart = getAimPart(plr.Character, CONFIG.TriggerBotTargetPart)
                if hum and hum.Health > 0 and targetPart then
                    local visible = true
                    if CONFIG.TriggerBotVisibleCheck then visible = isVisible(targetPart) end
                    if visible then
                        local dist = (targetPart.Position - myPos).Magnitude
                        if dist < bestDist then bestDist = dist; bestTarget = targetPart end
                    end
                end
            end
        end
        return bestTarget
    end
    local ray = Camera:ViewportPointToRay(mp.X, mp.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {Camera}
    if LP.Character then table.insert(ignore, LP.Character) end
    params.FilterDescendantsInstances = ignore
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 2000, params)
    if not result then return nil end
    local hit = result.Instance
    if not hit then return nil end
    local char = hit:FindFirstAncestorOfClass("Model")
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    if char == LP.Character then return nil end
    local plr = Players:GetPlayerFromCharacter(char)
    if not plr or plr == LP then return nil end
    local targetPart = getAimPart(char, CONFIG.TriggerBotTargetPart)
    if CONFIG.TriggerBotVisibleCheck and targetPart then
        if not isVisible(targetPart) then return nil end
    end
    return targetPart
end

local function isTriggerKeyDown()
    local key = CONFIG.TriggerBotKey
    if typeof(key) == "EnumItem" then
        if key.EnumType == Enum.KeyCode then return KeyState[key] == true
        elseif key.EnumType == Enum.UserInputType then return KeyState[key] == true end
    end
    return false
end

RunService.RenderStepped:Connect(function()
    if not CONFIG.TriggerBotEnabled then return end
    if not isTriggerKeyDown() then return end
    local now = tick()
    if now - TriggerBotState.LastFire < (CONFIG.TriggerBotDelay or 0.05) then return end
    local target = getTargetUnderCrosshair()
    if not target then return end
    TriggerBotState.LastFire = now
    TriggerBotState.IsFiring = true
    task.spawn(function()
        simulateFire()
        TriggerBotState.IsFiring = false
    end)
end)

