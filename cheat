-- THIRD PERSON
-- ============================================================
local function enableThirdPerson()
    if ThirdPerson.enabled then return end
    local char = LocalPlayer.Character
    if not char then
        Library:Notify({Title = "Third Person", Description = "No character found!", Time = 3}); return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        Library:Notify({Title = "Third Person", Description = "No Humanoid found!", Time = 3}); return
    end

    ThirdPerson.origFOV = Camera.FieldOfView

    ThirdPerson.connection = RunService.RenderStepped:Connect(function()
        if not ThirdPerson.enabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local hrp = c:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        local dist     = (Options.TPDistance and Options.TPDistance.Value) or 8
        local height   = (Options.TPHeight and Options.TPHeight.Value) or 0
        local shoulder = (Options.TPShoulder and Options.TPShoulder.Value) or 0

        local camCF = Camera.CFrame
        local flatDir = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
        if flatDir.Magnitude < 0.01 then flatDir = Vector3.new(0, 0, 1) end
        flatDir = flatDir.Unit
        local rightVec = Vector3.new(flatDir.Z, 0, -flatDir.X)

        local basePos = hrp.Position + Vector3.new(0, height, 0)
        local newPos = basePos - flatDir * dist + rightVec * shoulder

        Camera.CFrame = CFrame.new(newPos) * (camCF - camCF.Position)

        if Toggles.TPCustomFOV and Toggles.TPCustomFOV.Value and Options.TPFOV then
            Camera.FieldOfView = Options.TPFOV.Value
        end
    end)

    ThirdPerson.enabled = true
    Library:Notify({Title = "Third Person", Description = "Enabled (visual)", Time = 2})
end

local function disableThirdPerson()
    if not ThirdPerson.enabled then return end
    if ThirdPerson.connection then
        ThirdPerson.connection:Disconnect()
        ThirdPerson.connection = nil
    end
    if ThirdPerson.origFOV then Camera.FieldOfView = ThirdPerson.origFOV end
    ThirdPerson.enabled = false
    Library:Notify({Title = "Third Person", Description = "Disabled", Time = 2})
end

local function toggleThirdPerson()
    if ThirdPerson.enabled then disableThirdPerson() else enableThirdPerson() end
    if Toggles.TPOn then Toggles.TPOn:Set(ThirdPerson.enabled) end
end

