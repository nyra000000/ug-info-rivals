local function addHL(p)
    if p == LocalPlayer then return end
    local function onChar(ch)
        pcall(function()
            if Highlights[p] then Highlights[p]:Destroy() end
        end)
        local hl = Instance.new("Highlight")
        hl.Name = "OHL"
        hl.FillTransparency = 0.75
        hl.OutlineTransparency = 0
        hl.Adornee = ch
        hl.Enabled = false
        hl.Parent = ch
        Highlights[p] = hl
        if HasDrawing then makeCache(p) end
    end
    if p.Character then onChar(p.Character) end
    p.CharacterAdded:Connect(onChar)
end

local function removeHL(p)
    pcall(function()
        if Highlights[p] then Highlights[p]:Destroy() end
    end)
    Highlights[p] = nil
    removeCache(p)
    EnemyHP[p] = nil
    PrevAliveState[p] = nil
    _tcache[p] = nil
end

for _, p in ipairs(Players:GetPlayers()) do addHL(p) end
Players.PlayerAdded:Connect(addHL)
Players.PlayerRemoving:Connect(removeHL)

Players.PlayerRemoving:Connect(function(p) _tcache[p] = nil end)
Players.PlayerAdded:Connect(function(p) 
    p.CharacterAdded:Connect(function() _tcache[p] = nil end) 
end)

