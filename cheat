-- ============================================================
-- SAVE / LOAD
-- ============================================================
local CONFIG_FILE = "UG_INFO_Rivals_Config.json"

local function encodeConfig()
    local data = {}
    for k, v in pairs(CONFIG) do
        local t = typeof(v)
        if t == "EnumItem" then data[k] = {__type="Enum", enum=v.EnumType.Name, name=v.Name}
        elseif t == "Color3" then data[k] = {__type="Color3", r=v.R, g=v.G, b=v.B}
        else data[k] = v end
    end
    return HttpService:JSONEncode(data)
end

local function decodeAndApply(json)
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then return false end
    for k, v in pairs(data) do
        if type(v) == "table" and v.__type == "Enum" then
            local et = Enum[v.enum]; if et and et[v.name] then CONFIG[k] = et[v.name] end
        elseif type(v) == "table" and v.__type == "Color3" then
            CONFIG[k] = Color3.new(v.r, v.g, v.b)
        else CONFIG[k] = v end
    end
    applyConfig(); return true
end

local function saveConfig()
    local json = encodeConfig()
    SHARED.UG_INFO_SavedConfig = json
    local method = "memory"
    if writefile then
        local ok = pcall(writefile, CONFIG_FILE, json)
        if ok then method = "file" end
    end
    return true, method
end

local function loadConfig()
    local json, source
    if readfile then
        local exists = true
        if isfile then local ok, r = pcall(isfile, CONFIG_FILE); if ok then exists = r end end
        if exists then
            local ok, c = pcall(readfile, CONFIG_FILE)
            if ok and c and c ~= "" then json = c; source = "file" end
        end
    end
    if not json and SHARED.UG_INFO_SavedConfig then
        json = SHARED.UG_INFO_SavedConfig; source = "memory"
    end
    if not json then return false, nil end
    return decodeAndApply(json), source
end

local function resetConfig()
    for k, v in pairs(DEFAULT_CONFIG) do CONFIG[k] = v end
    applyConfig()
end

