local function findTarget()
    if not Options.AimFOV or not Options.AimPart or not Options.AimDist then return nil end
    local best, bestD = nil, Options.AimFOV.Value
    local ctr = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local camP = Camera.CFrame.Position
    local useTeamCheck = Toggles.AimTeamCheck and Toggles.AimTeamCheck.Value
    local useDeadCheck = Toggles.AimDeadCheck and Toggles.AimDeadCheck.Value
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not isAlive(p, useDeadCheck) then continue end
        if useTeamCheck and not isEnemy(p, true) then continue end
        if AntiKatanaState.enabled and hasKatanaEquipped(p) then continue end
        local ch = p.Character
        if not ch then continue end
        local part = getPart(ch, Options.AimPart.Value)
        if not part then continue end
        if dist3(camP, part.Position) > Options.AimDist.Value then continue end
        if Toggles.AimVisCheck and Toggles.AimVisCheck.Value and not isVisible(camP, part) then continue end
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if on then
            local d = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
            if d < bestD then bestD = d; best = p end
        end
    end
    return best
end

-- =============================================
-- AIMBOT — LOCK AGRESSIF
-- =============================================
local function aimAt(tgt)
    if not tgt or not tgt.Character then return end
    local part = getPart(tgt.Character, Options.AimPart.Value)
    if not part then return end
    if Toggles.AimSticky and Toggles.AimSticky.Value and StickyTarget ~= tgt then
        StickyTarget = tgt; StickyLocked = true
    end
    local sp, on = Camera:WorldToViewportPoint(part.Position)
    if not on then return end
    local vp = Camera.ViewportSize
    local delta = Vector2.new(sp.X, sp.Y) - Vector2.new(vp.X/2, vp.Y/2)

    -- === LOCK AGRESSIF ===
    local sm = 1
    if Toggles.AimMouseHard and Toggles.AimMouseHard.Value then
        sm = 0.4
    else
        sm = math.max(Options.AimSm.Value * 0.35, 0.35)
    end

    if Toggles.AimSticky and Toggles.AimSticky.Value and StickyLocked then
        sm = sm * (1 - math.min(Options.AimStickyStr.Value * 1.15, 1))
    end

    sm = math.clamp(sm, 0.25, 20)

    local mag = delta.Magnitude
    if mag < 0.15 then return end

    local mx = math.floor(delta.X / sm)
    local my = math.floor(delta.Y / sm)

    -- snap si très proche → lock instantané
    if math.abs(delta.X) < 3 then mx = math.floor(delta.X) end
    if math.abs(delta.Y) < 3 then my = math.floor(delta.Y) end

    if math.abs(mx) < 1 and math.abs(delta.X) > 0.5 then mx = (delta.X > 0) and 1 or -1 end
    if math.abs(my) < 1 and math.abs(delta.Y) > 0.5 then my = (delta.Y > 0) and 1 or -1 end

    safeMouseMoveRel(mx, my)
end

