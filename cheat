local function saveOriginalLighting()
    OrigLighting = {
        Ambient = pcall(function() return Lighting.Ambient end) and Lighting.Ambient or Color3.new(0.5, 0.5, 0.5),
        Brightness = pcall(function() return Lighting.Brightness end) and Lighting.Brightness or 1,
        ColorShift_Bottom = pcall(function() return Lighting.ColorShift_Bottom end) and Lighting.ColorShift_Bottom or Color3.new(0, 0, 0),
        ColorShift_Top = pcall(function() return Lighting.ColorShift_Top end) and Lighting.ColorShift_Top or Color3.new(0, 0, 0),
        EnvironmentDiffuseScale = pcall(function() return Lighting.EnvironmentDiffuseScale end) and Lighting.EnvironmentDiffuseScale or 1,
        EnvironmentSpecularScale = pcall(function() return Lighting.EnvironmentSpecularScale end) and Lighting.EnvironmentSpecularScale or 1,
        ExposureCompensation = pcall(function() return Lighting.ExposureCompensation end) and Lighting.ExposureCompensation or 0,
        FogColor = pcall(function() return Lighting.FogColor end) and Lighting.FogColor or Color3.new(0.75, 0.75, 0.75),
