        if SYNC_GUARD then return end
        local t = getActive()
        if t.alpha then CONFIG[t.alpha] = rel; refreshAll() end
    end)
    bindSlider(hueBg, function(rel)
        if SYNC_GUARD then return end
        local t = getActive(); local c = CONFIG[t.key]
        local _, s, v = Color3.toHSV(c)
        CONFIG[t.key] = Color3.fromHSV(rel, s, v); refreshAll()
    end)
    bindSlider(rsBg, function(rel)
        if SYNC_GUARD then return end
        local t = getActive()
        if t.speed then CONFIG[t.speed] = rel * 3; refreshAll() end
    end)

    do
        local svDragging = false
        local svBtn = Instance.new("TextButton")
        svBtn.Size = UDim2.new(1, 0, 1, 0)
        svBtn.BackgroundTransparency = 1; svBtn.Text = ""; svBtn.Parent = svSquare
        local function updSV(mx, my)
            local ap = svSquare.AbsolutePosition; local as = svSquare.AbsoluteSize
            local rx = math.clamp((mx - ap.X) / as.X, 0, 1)
            local ry = math.clamp((my - ap.Y) / as.Y, 0, 1)
            local t = getActive(); local c = CONFIG[t.key]
            local h = select(1, Color3.toHSV(c))
            CONFIG[t.key] = Color3.fromHSV(h, rx, 1 - ry); refreshAll()
        end
        svBtn.MouseButton1Down:Connect(function()
            svDragging = true
            local mp = UserInputService:GetMouseLocation()
            updSV(mp.X, mp.Y)
        end)
        UserInputService.InputChanged:Connect(function(input)
            if svDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                updSV(input.Position.X, input.Position.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false end
        end)
    end

    rainbowToggleRow.MouseButton1Click:Connect(function()
        local t = getActive()
        if not t.rainbow then return end
        CONFIG[t.rainbow] = not CONFIG[t.rainbow]
        refreshAll()
    end)

    local resetBtn = Instance.new("TextButton")
    resetBtn.Size = UDim2.new(1, -20, 0, 30); resetBtn.Position = UDim2.new(0, 10, 1, -40)
    resetBtn.BackgroundColor3 = COL.card
    resetBtn.Text = "↺   RÉINITIALISER CETTE COULEUR"
    resetBtn.TextColor3 = COL.text; resetBtn.Font = Enum.Font.GothamBold
    resetBtn.TextSize = 11; resetBtn.AutoButtonColor = false; resetBtn.Parent = panel
    local rbc = Instance.new("UICorner"); rbc.CornerRadius = UDim.new(0, 8); rbc.Parent = resetBtn
    local rbs = Instance.new("UIStroke"); rbs.Color = COL.border; rbs.Thickness = 1; rbs.Transparency = 0.3; rbs.Parent = resetBtn
    resetBtn.MouseButton1Click:Connect(function()
        local t = getActive()
        CONFIG[t.key] = DEFAULT_CONFIG[t.key]
        if t.alpha then CONFIG[t.alpha] = DEFAULT_CONFIG[t.alpha] end
        if t.rainbow then CONFIG[t.rainbow] = DEFAULT_CONFIG[t.rainbow] end
        if t.speed then CONFIG[t.speed] = DEFAULT_CONFIG[t.speed] end
        refreshAll()
    end)

    refreshAll()
    return sg, refreshAll
end

