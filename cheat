local function enableFly()
    if FlyState.enabled then return end
    local char = LocalPlayer.Character
    if not char then safeNotify("Fly", "No character!", 3); return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then safeNotify("Fly", "Missing HRP/Humanoid!", 3); return end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "ENI_Fly_Velocity"
    bv.MaxForce = Vector3.new(1e9,1e9,1e9)
    bv.Velocity = Vector3.new(0,0,0)
    bv.P = 1250
    bv.Parent = hrp
    FlyState.velocity = bv

    local bg = Instance.new("BodyGyro")
    bg.Name = "ENI_Fly_Gyro"
    bg.MaxTorque = Vector3.new(1e9,1e9,1e9)
    bg.P = 3000
    bg.D = 500
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp
    FlyState.gyro = bg

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            FlyState.originalCollide[part] = part.CanCollide
            part.CanCollide = false
        end
    end

    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function() hum.PlatformStand = true end)

    FlyState.connection = RunService.RenderStepped:Connect(function(dt)
        if not FlyState.enabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        if not root then return end
        local speed = (Options.FlySpeed and Options.FlySpeed.Value) or 50
        local vertSpeed = (Options.FlyVerticalSpeed and Options.FlyVerticalSpeed.Value) or 50
        local mode = (Options.FlyMode and Options.FlyMode.Value) or "Camera"
        local moveDir = Vector3.zero
        local camCF = Camera.CFrame
        local look = camCF.LookVector
        local right = camCF.RightVector
        if mode == "Camera" then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - look end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end
        else
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local flatRight = Vector3.new(right.X, 0, right.Z)
            if flatLook.Magnitude > 0.01 then flatLook = flatLook.Unit end
            if flatRight.Magnitude > 0.01 then flatRight = flatRight.Unit end
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + flatLook end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - flatLook end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + flatRight end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - flatRight end
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0,1,0) end
        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
            local finalSpeed = speed
            if math.abs(moveDir.Y) > 0.5 then finalSpeed = vertSpeed end
            bv.Velocity = moveDir * finalSpeed
        else
            bv.Velocity = Vector3.zero
        end
        bg.CFrame = CFrame.new(root.Position, root.Position + look)
    end)
    FlyState.enabled = true
    safeNotify("Fly", "Enabled", 4)
end

local function disableFly()
    if not FlyState.enabled then return end
    if FlyState.connection then FlyState.connection:Disconnect(); FlyState.connection = nil end
    if FlyState.velocity then pcall(function() FlyState.velocity:Destroy() end); FlyState.velocity = nil end
    if FlyState.gyro then pcall(function() FlyState.gyro:Destroy() end); FlyState.gyro = nil end
    local char = LocalPlayer.Character
    if char then
        for part, state in pairs(FlyState.originalCollide) do
            if part and part.Parent then pcall(function() part.CanCollide = state end) end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.PlatformStand = false end)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end
    end
    FlyState.originalCollide = {}
    FlyState.enabled = false
    safeNotify("Fly", "Disabled", 2)
end

local function toggleFly()
    if FlyState.enabled then disableFly() else enableFly() end
    if Toggles.FlyOn and Toggles.FlyOn.SetValue then pcall(function() Toggles.FlyOn:SetValue(FlyState.enabled) end) end
