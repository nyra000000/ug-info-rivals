-- =============================================
-- CLEANUP
-- =============================================
Library:OnUnload(function()
    for _, c in pairs(Connections) do
        if c and typeof(c) == "RBXScriptConnection" then c:Disconnect() end
    end
    if TPUnderEnemy.connection then TPUnderEnemy.connection:Disconnect() end
    if ThirdPerson.connection then ThirdPerson.connection:Disconnect() end
    if FlyState.connection then FlyState.connection:Disconnect() end
    if FlyState.velocity then pcall(function() FlyState.velocity:Destroy() end) end
    if FlyState.gyro then pcall(function() FlyState.gyro:Destroy() end) end
    if HasDrawing then
        if FOVDraw then pcall(function() FOVDraw:Remove() end) end
        if FOVFillDraw then pcall(function() FOVFillDraw:Remove() end) end
        for _, l in ipairs(CrossLines) do pcall(function() l:Remove() end) end
        for _, bt in ipairs(BT_Cache) do if bt.line then pcall(function() bt.line:Remove() end) end end
    end
    for p in pairs(ESPCache) do removeCache(p) end
    for _, hl in pairs(Highlights) do pcall(function() if hl then hl:Destroy() end end) end
    restoreSkybox()
    restoreAmbience()
    pcall(function()
        restoreDecals(); restoreParticles(); restoreTextures(); restoreMeshDetails()
        restoreTerrainDetails(); restoreShadows(); restoreFog(); restorePostEffects(); removePixelation()
    end)
    pcall(function() if setfpscap then setfpscap(FPSState.originalCap) end end)
    removeFpsLabel()
    for o, e in pairs(StoredEffects) do if o and o.Parent then o.Enabled = e end end
    if BloomEffect then pcall(function() BloomEffect:Destroy() end) end
    if ColorCorrection then pcall(function() ColorCorrection:Destroy() end) end
    safeSetCameraFOV(70)
    if ThirdPerson.enabled then disableThirdPerson() end
    if FlyState.enabled then disableFly() end
    destroySelfHighlight()
    if TPUnderEnemy.enabled then
        if TPUnderEnemy.startPosition then
            local char = LocalPlayer.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then root.CFrame = CFrame.new(TPUnderEnemy.startPosition) * root.CFrame.Rotation end
            end
        end
        disableNoclip()
    end
end)

