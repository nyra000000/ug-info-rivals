local _tcache = {}
local TC_TTL = 0.4

local function isVisible(from, targetPart)
    if not targetPart then return false end
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local dir = targetPart.Position - from
    local result = workspace:Raycast(from, dir, rp)
    if not result then return true end
    return result.Instance == targetPart or result.Instance:IsDescendantOf(targetPart.Parent)
end

local isEnemy = function(playerToCheck, useTeamCheck)
    if not playerToCheck or not playerToCheck.Character or typeof(playerToCheck.Character) ~= "Instance" then return false end
    if not useTeamCheck then return true end
    local now = tick()
    local cached = _tcache[playerToCheck]
    if cached and (now - cached.t) < TC_TTL then return cached.v end
    local isTeam = false
    for _, obj in ipairs(playerToCheck.Character:GetDescendants()) do
        if typeof(obj) == "Instance" and (obj:IsA("BillboardGui") or (obj:IsA("Highlight") and obj.Name ~= "OHL")) then
            isTeam = true; break
        end
    end
    _tcache[playerToCheck] = {v = not isTeam, t = now}
    return not isTeam
end

