local CONFIG_FILE = "UG_INFO_Rivals_Config.json"
local HAS_FILE_IO = (writefile ~= nil and readfile ~= nil and isfile ~= nil)
local AUTOSAVE_DELAY = 1.5

local function getEnumKind(v)
    local kind = "Key"
    pcall(function()
        if v.EnumType == Enum.UserInputType then kind = "Mouse"
        elseif v.EnumType == Enum.KeyCode then kind = "Key" end
    end)
    return kind
end

local function encodeConfig()
    local data = {}
    for k, v in pairs(CONFIG) do
        local t = typeof(v)
        if t == "EnumItem" then
            data[k] = {__type="Enum", kind=getEnumKind(v), name=v.Name}
        elseif t == "Color3" then
            data[k] = {__type="Color3", r=v.R, g=v.G, b=v.B}
        elseif t == "Vector3" then
            data[k] = {__type="Vector3", x=v.X, y=v.Y, z=v.Z}
        else
            data[k] = v
        end
    end
    local ok, json = pcall(function() return HttpService:JSONEncode(data) end)
    if ok and json then return json end
    return "{}"
end

local function decodeAndApply(json)
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then return false, "JSON invalide" end
    local applied = 0
    for k, v in pairs(data) do
        if CONFIG[k] ~= nil then
            if type(v) == "table" and v.__type == "Enum" then
                local et
                if v.kind == "Mouse" then et = Enum.UserInputType
                else et = Enum.KeyCode end
                if et and et[v.name] then CONFIG[k] = et[v.name]; applied = applied + 1 end
            elseif type(v) == "table" and v.__type == "Color3" then
                CONFIG[k] = Color3.new(v.r, v.g, v.b); applied = applied + 1
            elseif type(v) == "table" and v.__type == "Vector3" then
                CONFIG[k] = Vector3.new(v.x, v.y, v.z); applied = applied + 1
            else
                CONFIG[k] = v; applied = applied + 1
            end
        end
    end
    applyConfig()
    return true, applied .. " valeurs chargées"
end

saveConfig = function()
    local json = encodeConfig()
    SHARED.UG_INFO_SavedConfig = json
    local method = "memory"
    local ok = false
    if HAS_FILE_IO then
        local writeOk, err = pcall(writefile, CONFIG_FILE, json)
        if writeOk then ok = true; method = "file"
        else warn("[UG INFO] writefile a échoué : " .. tostring(err)) end
    end
    return ok, method
end

loadConfig = function()
    local json, source
    if HAS_FILE_IO then
        local exists = false
        local existsOk, existsResult = pcall(isfile, CONFIG_FILE)
        if existsOk then exists = existsResult end
        if exists then
            local readOk, content = pcall(readfile, CONFIG_FILE)
            if readOk and content and content ~= "" then
                json = content; source = "file"
            end
        end
    end
    if not json and SHARED.UG_INFO_SavedConfig then
        json = SHARED.UG_INFO_SavedConfig; source = "memory"
    end
    if not json then return false, "Aucune config trouvée", nil end
    local ok, msg = decodeAndApply(json)
    return ok, msg, source
end

resetConfig = function()
    for k, v in pairs(DEFAULT_CONFIG) do CONFIG[k] = v end
    applyConfig()
end

local autosavePending = false
local lastSavedJson = ""

local function scheduleAutosave()
    if autosavePending then return end
    autosavePending = true
    task.delay(AUTOSAVE_DELAY, function()
        autosavePending = false
        pcall(saveConfig)
    end)
end

task.spawn(function()
    task.wait(3)
    lastSavedJson = encodeConfig()
    while task.wait(2) do
        local currentJson = encodeConfig()
        if currentJson ~= lastSavedJson then
            lastSavedJson = currentJson
            scheduleAutosave()
        end
    end
end)

