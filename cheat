-- FPS COUNTER
-- =============================================
RunService.RenderStepped:Connect(function()
    FPSState.frameCount = FPSState.frameCount + 1
    local now = tick()
    if now - FPSState.lastTime >= 1 then
        FPSState.currentFps = FPSState.frameCount / (now - FPSState.lastTime)
        FPSState.frameCount = 0; FPSState.lastTime = now
        if FPSState.drawFpsLabel and Toggles.FPSShowCounter and Toggles.FPSShowCounter.Value then
            FPSState.drawFpsLabel.Text = string.format("FPS: %d", math.floor(FPSState.currentFps + 0.5))
        end
    end
end)

-- =============================================
-- HEARTBEAT PRINCIPAL
-- =============================================
RunService.Heartbeat:Connect(function()
    pcall(function()
        if Toggles.GPNoDecals and Toggles.GPNoDecals.Value then removeDecals() end
        if Toggles.GPNoParticles and Toggles.GPNoParticles.Value then removeParticles() end
        if Toggles.GPNoTextures and Toggles.GPNoTextures.Value then removeTextures() end
        if Toggles.GPNoMeshDetails and Toggles.GPNoMeshDetails.Value then removeMeshDetails() end
        if Toggles.GPNoTerrainDetails and Toggles.GPNoTerrainDetails.Value then removeTerrainDetails() end
        if Toggles.GPNoShadows and Toggles.GPNoShadows.Value then removeShadows() end
        if Toggles.GPNoFog and Toggles.GPNoFog.Value then removeFog() end
        if Toggles.GPNoPostFX and Toggles.GPNoPostFX.Value then removePostEffects() end
        if Toggles.GPPixel and Toggles.GPPixel.Value then applyPixelation() else removePixelation() end

        if Toggles.SelfHLOn and Toggles.SelfHLOn.Value then
            local char = LocalPlayer.Character
            if not SelfHighlight.instance or SelfHighlight.instance.Adornee ~= char then createSelfHighlight() end
            if SelfHighlight.instance then
                SelfHighlight.hue = (SelfHighlight.hue + ((Options.SelfHLSpeed and Options.SelfHLSpeed.Value) or 5) / 500) % 1
                SelfHighlight.instance.OutlineColor = Color3.fromHSV(SelfHighlight.hue, 1, 1)
            end
        elseif SelfHighlight.instance then
            destroySelfHighlight()
        end

        if HasDrawing and FOVDraw and FOVFillDraw and Toggles.AimShowFOV and Toggles.AimShowFOV.Value then
            local vp = Camera.ViewportSize
            local ctr = Vector2.new(vp.X/2, vp.Y/2)
            local fov = Options.AimFOV.Value
            FOVDraw.Radius = fov; FOVDraw.Position = ctr
            FOVDraw.Color = Options.AimFOVCol.Value
            FOVDraw.Transparency = Options.AimFOVTrans.Value
            FOVDraw.Visible = true
            FOVFillDraw.Radius = fov; FOVFillDraw.Position = ctr
            FOVFillDraw.Color = Options.AimFOVFillCol.Value
            FOVFillDraw.Transparency = Options.AimFOVFillTrans.Value
            FOVFillDraw.Visible = Toggles.AimFOVFill.Value
        elseif FOVDraw then
            FOVDraw.Visible = false
            if FOVFillDraw then FOVFillDraw.Visible = false end
        end

        if Toggles.AimOn and Toggles.AimOn.Value and Options.AimKey and Options.AimKey:GetState() then
            local target = nil
            if Toggles.AimSticky.Value and StickyLocked and StickyTarget then
                if StickyTarget.Character and isAlive(StickyTarget, true) then
                    local root = StickyTarget.Character:FindFirstChild("HumanoidRootPart")
                    if root then
                        local dist = dist3(Camera.CFrame.Position, root.Position)
                        local antiKatanaOk = true
                        if AntiKatanaState.enabled and hasKatanaEquipped(StickyTarget) then antiKatanaOk = false end
                        if dist <= (Options.AimDist.Value * 2) and antiKatanaOk then target = StickyTarget end
                    end
                end
                if not target then StickyLocked = false; StickyTarget = nil end
            end
            if not target then
                target = findTarget()
                if target then StickyLocked = true; StickyTarget = target end
            end
            if target then aimAt(target) end
        else
            StickyLocked = false; StickyTarget = nil
        end

        if Toggles.ScopeOn and Toggles.ScopeOn.Value then
            if Options.ScopeKey:GetState() then startScope() else stopScope() end
        end

        if Toggles.ESPRainbow and Toggles.ESPRainbow.Value then
            RainbowHue = (RainbowHue + (Options.ESPRBSpeed.Value / 1000)) % 1
        end

        local useTeamCheck = Toggles.ESPTeamCheck and Toggles.ESPTeamCheck.Value
        local useDeadCheck = Toggles.ESPDeadCheck and Toggles.ESPDeadCheck.Value
        for p, hl in pairs(Highlights) do
            if hl and hl.Parent then
                local isEnemyPlayer = not useTeamCheck or isEnemy(p, true)
                local isAlivePlayer = isAlive(p, useDeadCheck)
                hl.Enabled = Toggles.ESPOn and Toggles.ESPOn.Value and Toggles.ESPHL and Toggles.ESPHL.Value and isEnemyPlayer and isAlivePlayer
                if Toggles.ESPRainbow and Toggles.ESPRainbow.Value then
                    hl.FillColor = Color3.fromHSV(RainbowHue, 1, 1)
                    hl.OutlineColor = Color3.fromHSV(RainbowHue, 1, 1)
                else
                    hl.FillColor = Options.ESPHLCol.Value
                    hl.OutlineColor = Color3.new(1, 1, 1)
                end
                hl.FillTransparency = Options.ESPFillT.Value
                hl.OutlineTransparency = Options.ESPOutT.Value
            end
        end

        if HasDrawing then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    if not ESPCache[p] and p.Character then makeCache(p) end
                    updateDrawESP(p)
                end
            end
        end

        updateCrosshair()
        updateBT()
        updateSpeed()

        if Toggles.GravityOverride and Toggles.GravityOverride.Value then
            safeSetGravity(Options.GravitySlider.Value)
        end

        if Toggles.DeviceSpooferOn and Toggles.DeviceSpooferOn.Value then sendDeviceSpoofer() end

        if Toggles.Noclip and Toggles.Noclip.Value and not TPUnderEnemy.enabled and not FlyState.enabled then
            pcall(function()
                local ch = LocalPlayer.Character
                if ch then
                    for _, p in ipairs(ch:GetDescendants()) do
                        if p:IsA("BasePart") then p.CanCollide = false end
                    end
                end
            end)
        end

        local ambienceActive = Toggles.AmbienceOn and Toggles.AmbienceOn.Value and CurrentAmbience

        if Toggles.FullBright and Toggles.FullBright.Value then
            safeSetLighting("Ambient", Color3.new(1,1,1))
            safeSetLighting("Brightness", 2)
            safeSetLighting("OutdoorAmbient", Color3.new(1,1,1))
        elseif not ambienceActive and not (Toggles.NoShadows and Toggles.NoShadows.Value) then
            safeSetLighting("Ambient", OrigLighting.Ambient)
            safeSetLighting("Brightness", OrigLighting.Brightness)
            safeSetLighting("OutdoorAmbient", OrigLighting.OutdoorAmbient)
        end

        if Toggles.NoFog and Toggles.NoFog.Value then
            safeSetLighting("FogEnd", 1e9)
        elseif not ambienceActive and not (Toggles.GPNoFog and Toggles.GPNoFog.Value) then
            safeSetLighting("FogEnd", OrigLighting.FogEnd)
        end

        if Toggles.NoShadows and Toggles.NoShadows.Value then
            safeSetLighting("GlobalShadows", false)
        elseif not ambienceActive and not (Toggles.GPNoShadows and Toggles.GPNoShadows.Value) then
            safeSetLighting("GlobalShadows", OrigLighting.GlobalShadows)
        end

        if Toggles.ForceDay and Toggles.ForceDay.Value and not ambienceActive then
            safeSetLighting("ClockTime", 14)
        elseif Toggles.ForceNight and Toggles.ForceNight.Value and not ambienceActive then
            safeSetLighting("ClockTime", 0)
        elseif not ambienceActive then
            safeSetLighting("ClockTime", OrigLighting.ClockTime)
        end

        local ccActive = (Options.ColorSat.Value ~= 1) or (Options.ColorCon.Value ~= 0.5) or (Options.ColorBri.Value ~= 1)
        pcall(function()
            if ccActive then
                if not ColorCorrection then
                    ColorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
                    ColorCorrection.Name = "OCC"
                end
                ColorCorrection.Saturation = Options.ColorSat.Value
                ColorCorrection.Contrast = Options.ColorCon.Value * 2
                ColorCorrection.Brightness = Options.ColorBri.Value - 1
            elseif ColorCorrection then
                ColorCorrection:Destroy(); ColorCorrection = nil
            end
        end)

        pcall(function()
            if Options.BloomInt.Value > 0 then
                if not BloomEffect then
                    BloomEffect = Instance.new("BloomEffect", Lighting)
                    BloomEffect.Name = "OBL"
                end
                BloomEffect.Intensity = Options.BloomInt.Value
                BloomEffect.Threshold = Options.BloomThr.Value
                BloomEffect.Size = Options.BloomSz.Value
            elseif BloomEffect then
                BloomEffect:Destroy(); BloomEffect = nil
            end
        end)

        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local ph = p.Character:FindFirstChildOfClass("Humanoid")
                if ph then
                    local cur = safeGetHumanoidField(ph, "Health", ph.Health)
                    local prev = EnemyHP[p]
                    if prev and cur < prev and (prev - cur) < 100 and (prev - cur) > 0 then
                        if Toggles.HitSndOn and Toggles.HitSndOn.Value then
                            playSound(getHitSoundID(Options.HitSndPreset.Value), Options.HitSndVol.Value)
                        end
                    end
                    EnemyHP[p] = cur
                    local wasAlive = PrevAliveState[p]
                    local isAlive_ = cur > 0
                    if wasAlive == true and not isAlive_ then
                        if Toggles.KillSndOn and Toggles.KillSndOn.Value then
                            playSound(getKillSoundID(Options.KillSndPreset.Value), Options.KillSndVol.Value)
                        end
                    end
                    PrevAliveState[p] = isAlive_
                end
            end
        end
    end)
end)

