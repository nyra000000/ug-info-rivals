        if SYNC_GUARD then return end
        local t = getActive(); local c = CONFIG[t.key]
        CONFIG[t.key] = Color3.new(rel, c.G, c.B); refreshAll()
    end)
    bindSlider(gBg, function(rel)
        if SYNC_GUARD then return end
        local t = getActive(); local c = CONFIG[t.key]
        CONFIG[t.key] = Color3.new(c.R, rel, c.B); refreshAll()
    end)
    bindSlider(bBg, function(rel)
